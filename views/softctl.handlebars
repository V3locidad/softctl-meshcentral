<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Software Control</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { font-family: Segoe UI, Arial, sans-serif; font-size: 13px; padding: 10px; color: #222; box-sizing: border-box; display: flex; flex-direction: column; }
  h2 { margin: 0 0 10px 0; font-size: 16px; flex: 0 0 auto; }
  .bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 8px; flex: 0 0 auto; }
  .bar input[type=text] { padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  button { padding: 5px 10px; border: 1px solid #888; background: #fff; border-radius: 3px; cursor: pointer; font-size: 13px; }
  button.primary { background: #2c7be5; color: white; border-color: #2c7be5; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; background: #eee; font-size: 11px; margin-left: 6px; }
  .pill.ok { background: #d4edda; color: #155724; }
  .pill.bad { background: #f8d7da; color: #721c24; }
  .cols { display: flex; gap: 10px; flex: 1 1 auto; min-height: 0; }
  .col { flex: 1; border: 1px solid #ddd; border-radius: 4px; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .col h3 { margin: 0; padding: 8px; background: #eee; border-bottom: 1px solid #ddd; font-size: 13px; flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
  .col h3 .spacer { flex: 1; }
  .col .search { padding: 6px 8px; border-bottom: 1px solid #eee; flex: 0 0 auto; }
  .col .search input { width: 100%; box-sizing: border-box; padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  .col .body { flex: 1 1 auto; overflow: auto; min-height: 0; }
  .row { padding: 5px 10px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .row:hover { background: #f8f8ff; }
  .row.selected { background: #eef6ff; }
  .row input[type=checkbox] { flex: 0 0 auto; }
  .row .main { flex: 1; }
  .row .main .title { font-weight: 500; }
  .row .main .sub { color: #888; font-size: 11px; }
  .row .histBtn { flex: 0 0 auto; font-size: 11px; padding: 2px 8px; border: 1px solid #cfd5db; background: #f6f8fa; border-radius: 3px; cursor: pointer; }
  .row .histBtn:hover { background: #e9eef3; }
  .empty { color: #aaa; font-style: italic; padding: 12px; }
  #deployBar { margin-top: 10px; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  #deployBar .info { flex: 1; }
  #preview { margin-top: 10px; background: #111; color: #ddd; font-family: Menlo, Consolas, monospace; font-size: 12px; padding: 8px; border-radius: 4px; max-height: 220px; overflow: auto; white-space: pre-wrap; display: none; flex: 0 0 auto; }
  .badgeOs { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e2e3e5; color: #383d41; margin-right: 4px; }
  .badgeWarn { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #fff3cd; color: #856404; margin-left: 4px; }
  .badgeArch { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e2e3e5; color: #383d41; margin-left: 4px; font-family: Menlo, Consolas, monospace; }
  .resCell { padding: 3px 6px; border-radius: 3px; font-size: 11px; display: inline-block; min-width: 60px; text-align: center; }
  .resCell.success { background: #d4edda; color: #155724; }
  .resCell.fail    { background: #f8d7da; color: #721c24; }
  .resCell.pending { background: #fff3cd; color: #856404; }
  .resCell.offline { background: #e2e3e5; color: #383d41; }
  .rowActions { display: flex; gap: 4px; flex: 0 0 auto; opacity: 0; transition: opacity .1s; }
  .row:hover .rowActions { opacity: 1; }
  .rowActions button { padding: 2px 6px; font-size: 11px; }
  .modalBg { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
  .modal { background: #fff; border-radius: 6px; padding: 16px; min-width: 420px; max-width: 540px; max-height: 90vh; overflow: auto; }
  .modal h3 { margin: 0 0 12px 0; font-size: 15px; }
  .modal .field { margin-bottom: 10px; }
  .modal .field label { display: block; font-size: 12px; color: #555; margin-bottom: 3px; }
  .modal .field input[type=text], .modal .field input[type=file] { width: 100%; box-sizing: border-box; padding: 5px 7px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  .modal .field .help { color: #888; font-size: 11px; margin-top: 2px; }
  .modal .actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
  .modal .err { color: #721c24; background: #f8d7da; padding: 6px 10px; border-radius: 3px; margin-bottom: 10px; display: none; }
</style>
</head>
<body>

<h2>Software Control <span id="cfgState" class="pill">checking…</span></h2>

<div class="bar">
  <span style="flex:1"></span>
  <button id="historyBtn">Historique</button>
  <button id="refreshBtn" class="primary">Rafraîchir</button>
</div>

<div class="cols">
  <div class="col">
    <h3>Logiciels <span id="softCount" class="pill">0</span><span class="spacer"></span><button id="addSoftBtn" class="primary">+ Ajouter</button><button id="selAllSoft">Tout</button><button id="selNoneSoft">Aucun</button></h3>
    <div class="search"><input type="text" id="softFilter" placeholder="Filtrer (nom, éditeur, version…)"></div>
    <div class="body" id="softList"><div class="empty">Chargement…</div></div>
  </div>

  <div class="col">
    <h3>Postes <span id="agentCount" class="pill">0</span><span class="spacer"></span><button id="selAllAgent">Tout</button><button id="selNoneAgent">Aucun</button></h3>
    <div class="search" style="display:flex;gap:6px;align-items:center">
      <select id="meshSel" style="padding:3px 6px;border:1px solid #bbb;border-radius:3px;font-size:13px;max-width:50%"></select>
      <button id="selMeshBtn">Cocher la salle</button>
      <input type="text" id="agentFilter" placeholder="Filtrer (nom, salle, OS…)" style="flex:1">
    </div>
    <div class="body" id="agentList"><div class="empty">Chargement…</div></div>
  </div>
</div>

<div id="deployBar">
  <div class="info">
    <span id="selSummary">0 logiciel sélectionné · 0 poste sélectionné</span>
  </div>
  <button id="dryRunBtn" disabled>Aperçu</button>
  <button id="deployBtn" class="primary" disabled>Déployer</button>
</div>

<pre id="preview"></pre>
<div id="deployResult" style="display:none;margin-top:10px;border:1px solid #ddd;border-radius:4px;padding:10px;max-height:340px;overflow:auto;flex:0 0 auto"></div>

<script>
  function $(id) { return document.getElementById(id); }
  function api(action, params, body) {
    // MC bloque les POST sur pluginadmin.ashx (même problème que dans adctl).
    // On passe TOUT en GET, le body est encodé dans la query string en JSON.
    var qs = 'action=' + encodeURIComponent(action);
    if (params) Object.keys(params).forEach(function (k) {
      qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
    });
    if (body) qs += '&payload=' + encodeURIComponent(JSON.stringify(body));
    return fetch('/pluginadmin.ashx?pin=softctl&' + qs, { credentials: 'include' }).then(function (r) { return r.json(); });
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }
  function humanSize(n) {
    if (!n) return '';
    if (n < 1024) return n + ' o';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' Ko';
    if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + ' Mo';
    return (n / 1024 / 1024 / 1024).toFixed(2) + ' Go';
  }

  var softwares = [];
  var agents = [];
  var meshes = [];
  var softSel = {};   // id -> true
  var agentSel = {};  // id -> true

  function renderSoft() {
    var q = ($('softFilter').value || '').toLowerCase().trim();
    var rows = softwares.filter(function (s) {
      if (!q) return true;
      return [s.name, s.vendor, s.version, s.installer].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    $('softCount').textContent = softwares.length;
    if (!rows.length) { $('softList').innerHTML = '<div class="empty">Aucun logiciel.</div>'; return; }
    $('softList').innerHTML = rows.map(function (s) {
      var checked = softSel[s.id] ? ' checked' : '';
      var sel = softSel[s.id] ? ' selected' : '';
      var isZip = /\.zip$/i.test(s.installer || '');
      var warn = !s.installerOk ? '<span class="badgeWarn" title="Installeur introuvable dans le dossier">installeur manquant</span>'
               : (isZip && !s.archiveInstaller) ? '<span class="badgeWarn" title="archiveInstaller non défini : chemin de l\'installeur dans le zip">chemin archive manquant</span>'
               : !s.silentArgs ? '<span class="badgeWarn" title="silentArgs non défini — installation interactive">non-silencieux</span>'
               : (isZip ? '<span class="badgeWarn" style="background:#d1ecf1;color:#0c5460" title="Sera extrait avant install">archive</span>' : '');
      var archBadge = s.arch ? '<span class="badgeArch" title="Architecture détectée">' + escapeHtml(s.arch) + '</span>' : '';
      return '<div class="row' + sel + '" data-id="' + escapeHtml(s.id) + '">'
           +   '<input type="checkbox" class="chk"' + checked + '>'
           +   '<div class="main">'
           +     '<div class="title">' + escapeHtml(s.name) + (s.version ? ' <span style="color:#888;font-weight:normal">' + escapeHtml(s.version) + '</span>' : '') + archBadge + warn + '</div>'
           +     '<div class="sub">'
           +       (s.vendor ? escapeHtml(s.vendor) + ' · ' : '')
           +       (s.installer ? escapeHtml(s.installer) + ' · ' : '')
           +       humanSize(s.size)
           +       (s.silentArgs ? ' · args: <code>' + escapeHtml(s.silentArgs) + '</code>' : '')
           +     '</div>'
           +   '</div>'
           +   '<div class="rowActions">'
           +     '<button class="editBtn" data-id="' + escapeHtml(s.id) + '">Éditer</button>'
           +     '<button class="delBtn" data-id="' + escapeHtml(s.id) + '">Suppr.</button>'
           +   '</div>'
           + '</div>';
    }).join('');
    bindRowToggle('softList', softSel, renderSoft);
    [].slice.call(document.querySelectorAll('#softList .editBtn')).forEach(function (b) {
      b.onclick = function (ev) { ev.stopPropagation(); openEdit(b.getAttribute('data-id')); };
    });
    [].slice.call(document.querySelectorAll('#softList .delBtn')).forEach(function (b) {
      b.onclick = function (ev) { ev.stopPropagation(); deleteSoftware(b.getAttribute('data-id')); };
    });
  }

  function renderAgents() {
    var q = ($('agentFilter').value || '').toLowerCase().trim();
    var meshFilter = $('meshSel').value;  // empty = all salles
    var rows = agents.filter(function (a) {
      if (meshFilter && a.meshid !== meshFilter) return false;
      if (!q) return true;
      return [a.name, a.os, a.mesh].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    $('agentCount').textContent = rows.length + (rows.length !== agents.length ? ' / ' + agents.length : '');
    if (!rows.length) { $('agentList').innerHTML = '<div class="empty">Aucun poste.</div>'; return; }
    $('agentList').innerHTML = rows.map(function (a) {
      var checked = agentSel[a.id] ? ' checked' : '';
      var sel = agentSel[a.id] ? ' selected' : '';
      return '<div class="row' + sel + '" data-id="' + escapeHtml(a.id) + '">'
           +   '<input type="checkbox" class="chk"' + checked + '>'
           +   '<div class="main">'
           +     '<div class="title">' + escapeHtml(a.name) + '</div>'
           +     '<div class="sub">'
           +       (a.mesh ? '<span class="badgeOs" style="background:#d1ecf1;color:#0c5460">' + escapeHtml(a.mesh) + '</span>' : '')
           +       '<span class="badgeOs">' + escapeHtml(a.os || '?') + '</span>'
           +       (a.arch ? '<span class="badgeArch">' + escapeHtml(a.arch) + '</span>' : '')
           +     '</div>'
           +   '</div>'
           +   '<button class="histBtn" data-node="' + escapeHtml(a.id) + '" data-name="' + escapeHtml(a.name) + '" title="Voir l\'historique des déploiements sur ce poste">Historique</button>'
           + '</div>';
    }).join('');
    bindRowToggle('agentList', agentSel, renderAgents);
    // Bouton "Historique" par ligne — stoppe la propagation pour ne pas
    // toggle la sélection de l'agent.
    [].slice.call(document.querySelectorAll('#agentList .histBtn')).forEach(function (btn) {
      btn.onclick = function (ev) {
        ev.stopPropagation();
        openNodeHistory(btn.getAttribute('data-node'), btn.getAttribute('data-name'));
      };
    });
  }

  function openNodeHistory(nodeId, nodeName) {
    var bg = showModal([
      '<h3>Historique — ' + escapeHtml(nodeName || nodeId) + '</h3>',
      '<div id="nhBody">Chargement…</div>',
      '<div class="actions">',
      '  <button id="nhClear" style="background:#fbe9e7;color:#8a2a17;border-color:#f5c2b8">Vider pour ce poste</button>',
      '  <button id="nhClose">Fermer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#nhClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#nhClear').onclick = function () {
      if (!confirm('Retirer ' + (nodeName || nodeId) + ' de tout l\'historique des déploiements ?')) return;
      api('clearNodeHistory', { nodeId: nodeId }).then(function (r) {
        if (r && r.ok) { closeModal(bg); openNodeHistory(nodeId, nodeName); }
        else alert('Erreur : ' + (r && r.error || 'inconnue'));
      });
    };
    api('nodeHistory', { nodeId: nodeId }).then(function (r) {
      var deps = r.deployments || [];
      if (!deps.length) {
        bg.querySelector('#nhBody').innerHTML = '<div class="empty">Aucun déploiement sur ce poste.</div>';
        return;
      }
      var html = deps.map(function (d) {
        var when = new Date(d.timestamp).toLocaleString();
        var items = (d.items || []).map(function (it) {
          var cls = 'pending';
          var label = it.status || 'pending';
          if (it.status === 'success') { cls = 'success'; label = 'OK'; }
          else if (it.status === 'fail') { cls = 'fail'; label = 'KO (' + (it.exitCode != null ? it.exitCode : '?') + ')'; }
          else if (it.status === 'agent-offline') { cls = 'offline'; label = 'agent off'; }
          else if (it.status === 'dispatch-failed') { cls = 'fail'; label = 'dispatch KO'; }
          else if (it.status === 'cancelled') { cls = 'offline'; label = 'annulé'; }
          else if (it.status === 'dispatched') { cls = 'pending'; label = 'envoyé'; }
          return '<div style="margin-top:2px"><span class="resCell ' + cls + '">' + escapeHtml(label) + '</span> ' + escapeHtml(it.softName || it.softId) + '</div>';
        }).join('');
        return '<div style="padding:8px;border-bottom:1px solid #eee">'
             +   '<div><b>' + escapeHtml(when) + '</b> · par ' + escapeHtml(d.user || '?') + '</div>'
             +   items
             + '</div>';
      }).join('');
      bg.querySelector('#nhBody').innerHTML = html;
    });
  }

  function renderMeshSelect() {
    var opts = '<option value="">— Toutes les salles —</option>';
    meshes.forEach(function (m) {
      // Show how many agents the salle has; otherwise the dropdown is opaque.
      var count = agents.filter(function (a) { return a.meshid === m.id; }).length;
      opts += '<option value="' + escapeHtml(m.id) + '">' + escapeHtml(m.name) + ' (' + count + ')</option>';
    });
    $('meshSel').innerHTML = opts;
  }

  function bindRowToggle(containerId, selStore, rerender) {
    [].slice.call(document.querySelectorAll('#' + containerId + ' .row')).forEach(function (row) {
      row.onclick = function (ev) {
        // Ignore clicks on the checkbox itself — its native onchange will fire.
        if (ev.target && ev.target.classList && ev.target.classList.contains('chk')) return;
        var id = row.getAttribute('data-id');
        if (selStore[id]) delete selStore[id]; else selStore[id] = true;
        rerender();
        updateSummary();
      };
    });
    [].slice.call(document.querySelectorAll('#' + containerId + ' .chk')).forEach(function (chk) {
      chk.onchange = function () {
        var id = chk.parentNode.getAttribute('data-id');
        if (chk.checked) selStore[id] = true; else delete selStore[id];
        rerender();
        updateSummary();
      };
    });
  }

  function updateSummary() {
    var ns = Object.keys(softSel).length, na = Object.keys(agentSel).length;
    $('selSummary').textContent = ns + ' logiciel' + (ns > 1 ? 's' : '') + ' sélectionné' + (ns > 1 ? 's' : '')
                                + ' · ' + na + ' poste' + (na > 1 ? 's' : '') + ' sélectionné' + (na > 1 ? 's' : '');
    $('deployBtn').disabled = !(ns && na);
    $('dryRunBtn').disabled = !(ns && na);
  }

  function load() {
    $('softList').innerHTML = '<div class="empty">Chargement…</div>';
    $('agentList').innerHTML = '<div class="empty">Chargement…</div>';
    api('catalog').then(function (r) {
      if (r.error) {
        $('cfgState').textContent = 'Erreur: ' + r.error;
        $('cfgState').className = 'pill bad';
        $('softList').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>';
        return;
      }
      softwares = r.softwares || [];
      $('cfgState').textContent = softwares.length + ' logiciels, ' + (r.skipped || []).length + ' ignorés';
      $('cfgState').className = 'pill ok';
      renderSoft();
    });
    api('agents').then(function (r) {
      if (r.error) {
        $('agentList').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>';
        return;
      }
      agents = r.agents || [];
      meshes = r.meshes || [];
      renderMeshSelect();
      renderAgents();
    });
  }

  $('softFilter').oninput = renderSoft;
  $('agentFilter').oninput = renderAgents;
  $('refreshBtn').onclick = load;
  $('selAllSoft').onclick = function () { softwares.forEach(function (s) { softSel[s.id] = true; }); renderSoft(); updateSummary(); };
  $('selNoneSoft').onclick = function () { softSel = {}; renderSoft(); updateSummary(); };
  $('selAllAgent').onclick = function () { agents.forEach(function (a) { agentSel[a.id] = true; }); renderAgents(); updateSummary(); };
  $('selNoneAgent').onclick = function () { agentSel = {}; renderAgents(); updateSummary(); };
  $('meshSel').onchange = renderAgents;
  $('selMeshBtn').onclick = function () {
    var mid = $('meshSel').value;
    if (!mid) { alert('Choisis d\'abord une salle dans le menu déroulant.'); return; }
    agents.filter(function (a) { return a.meshid === mid; }).forEach(function (a) { agentSel[a.id] = true; });
    renderAgents(); updateSummary();
  };
  $('dryRunBtn').onclick = function () {
    var body = { softIds: Object.keys(softSel), nodeIds: Object.keys(agentSel) };
    $('preview').style.display = '';
    $('preview').textContent = 'Aperçu…';
    api('dryRun', null, body).then(function (r) {
      if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
      var lines = ['— APERÇU DÉPLOIEMENT —', r.note || '', ''];
      (r.plan || []).forEach(function (p) {
        lines.push('• ' + p.software);
        lines.push('    fichier  : ' + p.installer);
        lines.push('    silent   : ' + (p.silentArgs || '(non défini — installeur interactif)'));
        lines.push('    postes   : ' + p.nodes);
        lines.push('');
      });
      $('preview').textContent = lines.join('\n');
    });
  };

  // Détecte les mismatches d'arch entre softs et postes sélectionnés.
  // Retourne une liste lisible des avertissements.
  function detectArchMismatches() {
    var picked = softwares.filter(function (s) { return softSel[s.id]; });
    var pickedAgents = agents.filter(function (a) { return agentSel[a.id]; });
    var warnings = [];
    picked.forEach(function (s) {
      if (!s.arch) return;  // soft "any" — on suppose compatible partout
      pickedAgents.forEach(function (a) {
        if (!a.arch) return;
        // x64 installer sur poste x86 = bloqué techniquement par Windows. Autres
        // combinaisons (x86 sur x64 par ex.) marchent généralement, donc on
        // n'avertit que sur les vrais conflits.
        if (s.arch === 'x64' && a.arch === 'x86') warnings.push(s.name + ' (x64) ↛ ' + a.name + ' (x86)');
        if (s.arch === 'arm64' && a.arch !== 'arm64') warnings.push(s.name + ' (arm64) ↛ ' + a.name + ' (' + a.arch + ')');
      });
    });
    return warnings;
  }

  $('deployBtn').onclick = function () {
    var ns = Object.keys(softSel).length, na = Object.keys(agentSel).length;
    var warnings = detectArchMismatches();
    var msg = 'Déployer ' + ns + ' logiciel(s) sur ' + na + ' poste(s) ?\n\n'
            + 'Les installeurs vont s\'exécuter en arrière-plan sur chaque poste avec leurs arguments silencieux.\n'
            + 'Si silentArgs est vide, l\'installeur sera interactif et un utilisateur devra cliquer côté poste.';
    if (warnings.length) {
      msg += '\n\n⚠ ATTENTION — incompatibilités d\'architecture détectées :\n  ' + warnings.slice(0, 8).join('\n  ');
      if (warnings.length > 8) msg += '\n  … (+' + (warnings.length - 8) + ' autres)';
      msg += '\n\nContinuer malgré tout ?';
    }
    if (!confirm(msg)) return;
    var body = { softIds: Object.keys(softSel), nodeIds: Object.keys(agentSel) };
    $('preview').style.display = '';
    $('preview').textContent = 'Dispatch en cours…';
    $('deployBtn').disabled = true; $('deployBtn').textContent = 'En cours…';
    api('deploy', null, body).then(function (r) {
      $('deployBtn').textContent = 'Déployer'; $('deployBtn').disabled = !(ns && na);
      if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
      // On démarre un polling sur le deploymentId pour afficher l'avancement en
      // temps réel (5s d'intervalle, on arrête au bout de 10 min).
      if (r.deploymentId) followDeployment(r.deploymentId);
      else $('preview').textContent = (r.dispatched || 0) + ' commande(s) envoyée(s).';
    });
  };

  function statusLabel(st) {
    if (st === 'success') return 'OK';
    if (st === 'fail') return 'ÉCHEC';
    if (st === 'agent-offline') return 'agent off';
    if (st === 'dispatch-failed') return 'dispatch KO';
    if (st === 'cancelled') return 'annulé';
    return 'en cours…';
  }
  function statusClass(st) {
    if (st === 'success') return 'success';
    if (st === 'fail') return 'fail';
    if (st === 'agent-offline' || st === 'dispatch-failed' || st === 'cancelled') return 'offline';
    return 'pending';
  }
  // Tâche de polling en cours : on stocke l'ID + le flag de cancel pour pouvoir
  // l'arrêter quand l'utilisateur clique Annuler ou Fermer.
  var currentFollow = { id: null, stop: false };

  function followDeployment(id) {
    currentFollow = { id: id, stop: false };
    var startedAt = Date.now();
    var maxFollowMs = 10 * 60 * 1000;
    var tick = function () {
      if (currentFollow.stop || currentFollow.id !== id) return;
      api('deployment', { id: id }).then(function (r) {
        if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
        var d = r.deployment;
        if (!d) { $('preview').textContent = 'Déploiement introuvable.'; return; }
        renderDeployment(d);
        var allDone = Object.values(d.results || {}).every(function (x) {
          return x.status === 'success' || x.status === 'fail' || x.status === 'agent-offline' || x.status === 'dispatch-failed' || x.status === 'cancelled';
        });
        if (!allDone && (Date.now() - startedAt) < maxFollowMs && !currentFollow.stop) {
          setTimeout(tick, 5000);
        }
      });
    };
    tick();
  }

  function renderDeployment(d) {
    var agentName = function (n) {
      if (n.name) return n.name;
      var a = agents.find(function (x) { return x.id === n.id; });
      return a ? a.name : n.id.slice(0, 12);
    };
    var html = '<div style="background:#f4f4f4;padding:8px;border-radius:4px;margin-bottom:8px;display:flex;align-items:center;gap:8px">'
             + '<div style="flex:1"><b>Déploiement</b> ' + escapeHtml(d.id) + ' par ' + escapeHtml(d.user) + ' · ' + escapeHtml(new Date(d.timestamp).toLocaleString()) + '</div>'
             + '<button id="cancelDeployBtn">Annuler les en cours</button>'
             + '<button id="closeDeployBtn">Fermer</button>'
             + '</div>';
    html += '<table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:4px;border-bottom:1px solid #ddd">Poste</th>';
    (d.softs || []).forEach(function (s) {
      html += '<th style="text-align:left;padding:4px;border-bottom:1px solid #ddd">' + escapeHtml(s.name) + '</th>';
    });
    html += '</tr></thead><tbody>';
    (d.nodes || []).forEach(function (n) {
      html += '<tr><td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(agentName(n)) + '</td>';
      (d.softs || []).forEach(function (s) {
        var key = s.id + '|' + n.id;
        var r = (d.results || {})[key] || { status: 'pending' };
        var ec = r.exitCode != null ? ' (' + r.exitCode + ')' : '';
        var title = r.error ? ' title="' + escapeHtml(r.error) + '"' : '';
        html += '<td style="padding:4px;border-bottom:1px solid #f0f0f0"><span class="resCell ' + statusClass(r.status) + '"' + title + '>' + statusLabel(r.status) + ec + '</span></td>';
      });
      html += '</tr>';
    });
    html += '</tbody></table>';
    var div = $('deployResult');
    div.style.display = '';
    div.innerHTML = html;
    $('preview').style.display = 'none';
    document.getElementById('cancelDeployBtn').onclick = function () {
      if (!confirm('Marquer les installations en attente comme annulées ?\n\n(Note: les installs déjà en cours sur les postes vont à leur terme — Windows ne se laisse pas interrompre proprement à distance.)')) return;
      api('cancelDeployment', { id: d.id }).then(function () {
        currentFollow.stop = true;
        followDeployment(d.id);  // un dernier tick pour rafraîchir
      });
    };
    document.getElementById('closeDeployBtn').onclick = function () {
      currentFollow.stop = true;
      div.style.display = 'none';
      div.innerHTML = '';
    };
  }

  function openHistory() {
    var bg = showModal([
      '<h3>Historique des déploiements</h3>',
      '<div id="histBody">Chargement…</div>',
      '<div class="actions">',
      '  <button id="hClear" style="background:#fbe9e7;color:#8a2a17;border-color:#f5c2b8">Vider l\'historique</button>',
      '  <button id="hClose">Fermer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#hClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#hClear').onclick = function () {
      if (!confirm('Vider tout l\'historique des déploiements ? Cette action est irréversible.')) return;
      api('clearHistory').then(function (r) {
        if (r && r.ok) { closeModal(bg); openHistory(); }
        else alert('Erreur : ' + (r && r.error || 'inconnue'));
      });
    };
    api('history').then(function (r) {
      var rows = (r.deployments || []).map(function (d) {
        var c = d.counts || {};
        var when = new Date(d.timestamp).toLocaleString();
        var softs = (d.softs || []).map(function (s) { return s.name; }).join(', ');
        return '<div style="padding:6px 8px;border-bottom:1px solid #f0f0f0;cursor:pointer" data-id="' + escapeHtml(d.id) + '">'
             + '<div><b>' + escapeHtml(when) + '</b> · ' + escapeHtml(d.user) + '</div>'
             + '<div style="color:#666;font-size:11px;margin-top:2px">' + escapeHtml(softs.slice(0, 100)) + (softs.length > 100 ? '…' : '') + '</div>'
             + '<div style="margin-top:4px">'
             +   '<span class="resCell success">' + c.success + ' OK</span> '
             +   '<span class="resCell fail">' + c.fail + ' KO</span> '
             +   '<span class="resCell pending">' + c.pending + ' attente</span> '
             +   '<span class="resCell offline">' + c.offline + ' off</span>'
             + '</div></div>';
      }).join('');
      bg.querySelector('#histBody').innerHTML = rows || '<div class="empty">Pas encore de déploiement.</div>';
      [].slice.call(bg.querySelectorAll('[data-id]')).forEach(function (el) {
        el.onclick = function () {
          var id = el.getAttribute('data-id');
          closeModal(bg);
          followDeployment(id);
        };
      });
    });
  }
  $('historyBtn').onclick = openHistory;

  // ---- modal helpers ----
  function showModal(html) {
    var bg = document.createElement('div');
    bg.className = 'modalBg';
    bg.innerHTML = '<div class="modal">' + html + '</div>';
    document.body.appendChild(bg);
    bg.onclick = function (e) { if (e.target === bg) document.body.removeChild(bg); };
    return bg;
  }
  function closeModal(bg) { if (bg && bg.parentNode) bg.parentNode.removeChild(bg); }

  function openAdd() {
    var bg = showModal([
      '<h3>Ajouter un logiciel</h3>',
      '<div class="err" id="addErr"></div>',
      '<div class="field"><label>Nom *</label><input type="text" id="aName" placeholder="Notepad++"></div>',
      '<div style="display:flex;gap:8px">',
      '  <div class="field" style="flex:1"><label>Version</label><input type="text" id="aVersion" placeholder="8.6"></div>',
      '  <div class="field" style="flex:1"><label>Éditeur</label><input type="text" id="aVendor" placeholder="Don Ho"></div>',
      '</div>',
      '<div class="field"><label>Arguments silencieux</label><input type="text" id="aSilent" placeholder="/S">',
      '  <div class="help">Ex : <code>/S</code> (NSIS), <code>/quiet /norestart</code> (MSI), <code>/qn</code>, <code>--silent</code>, …</div>',
      '</div>',
      '<div class="field"><label>Installeur (.exe / .msi / .zip) *</label><input type="file" id="aFile" accept=".exe,.msi,.zip">',
      '  <div class="help">Le fichier sera copié sur le NAS. Si tu choisis un .zip, l\'archive sera extraite côté poste avant l\'install.</div>',
      '</div>',
      '<div class="field"><label>Chemin dans le .zip (si applicable)</label><input type="text" id="aArchive" placeholder="Anagene/setup.exe">',
      '  <div class="help">Pour un installeur multi-fichiers livré en .zip : chemin relatif de l\'exécutable principal à l\'intérieur de l\'archive.</div>',
      '</div>',
      '<div class="actions">',
      '  <button id="aCancel">Annuler</button>',
      '  <button id="aSubmit" class="primary">Ajouter</button>',
      '</div>',
    ].join(''));
    var cancel = function () { closeModal(bg); };
    bg.querySelector('#aCancel').onclick = cancel;
    bg.querySelector('#aSubmit').onclick = function () {
      var name = bg.querySelector('#aName').value.trim();
      var file = bg.querySelector('#aFile').files[0];
      var err = bg.querySelector('#addErr');
      err.style.display = 'none';
      if (!name) { err.textContent = 'Nom requis.'; err.style.display = 'block'; return; }
      if (!file) { err.textContent = 'Installeur requis.'; err.style.display = 'block'; return; }
      var params = {
        mode: 'add',
        name: name,
        version: bg.querySelector('#aVersion').value.trim(),
        vendor: bg.querySelector('#aVendor').value.trim(),
        silentArgs: bg.querySelector('#aSilent').value.trim(),
        filename: file.name,
        archiveInstaller: bg.querySelector('#aArchive').value.trim(),
      };
      var submit = bg.querySelector('#aSubmit');
      submit.disabled = true; submit.textContent = 'Préparation…';
      // Étape 1 : récupère un token + URL via GET (pluginadmin).
      api('requestUploadToken', params).then(function (r1) {
        if (r1.error) { err.textContent = r1.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Ajouter'; return null; }
        submit.textContent = 'Upload…';
        // Étape 2 : PUT le fichier sur l'endpoint custom (hors pluginadmin).
        return fetch(r1.url, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/octet-stream' }, body: file })
          .then(function (r) { return r.json(); });
      }).then(function (r2) {
        if (!r2) return;
        if (r2.error) { err.textContent = r2.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Ajouter'; return; }
        closeModal(bg); load();
      });
    };
  }

  function openEdit(slug) {
    var s = softwares.find(function (x) { return x.id === slug; });
    if (!s) return;
    var bg = showModal([
      '<h3>Éditer ' + escapeHtml(s.name) + '</h3>',
      '<div class="err" id="eErr"></div>',
      '<div class="field"><label>Nom *</label><input type="text" id="eName" value="' + escapeHtml(s.name) + '"></div>',
      '<div style="display:flex;gap:8px">',
      '  <div class="field" style="flex:1"><label>Version</label><input type="text" id="eVersion" value="' + escapeHtml(s.version) + '"></div>',
      '  <div class="field" style="flex:1"><label>Éditeur</label><input type="text" id="eVendor" value="' + escapeHtml(s.vendor) + '"></div>',
      '</div>',
      '<div class="field"><label>Arguments silencieux</label><input type="text" id="eSilent" value="' + escapeHtml(s.silentArgs) + '"></div>',
      '<div class="field"><label>Fichier installeur (nom)</label><input type="text" id="eInstaller" value="' + escapeHtml(s.installer) + '">',
      '  <div class="help">Nom du fichier dans le dossier. Pour le remplacer par un nouveau binaire, utilise le champ ci-dessous.</div>',
      '</div>',
      '<div class="field"><label>Architecture</label>',
      '  <select id="eArch">',
      '    <option value=""' + (!s.arch ? ' selected' : '') + '>Auto / Toutes</option>',
      '    <option value="x86"' + (s.arch === 'x86' ? ' selected' : '') + '>x86 (32-bit)</option>',
      '    <option value="x64"' + (s.arch === 'x64' ? ' selected' : '') + '>x64 (64-bit)</option>',
      '    <option value="arm64"' + (s.arch === 'arm64' ? ' selected' : '') + '>ARM64</option>',
      '  </select>',
      '  <div class="help">Sert à filtrer/avertir quand l\'arch du poste ne correspond pas. "Auto" devine depuis le nom de fichier.</div>',
      '</div>',
      '<div class="field"><label>Chemin dans le .zip (si applicable)</label><input type="text" id="eArchive" value="' + escapeHtml(s.archiveInstaller || '') + '" placeholder="Anagene/setup.exe">',
      '  <div class="help">Uniquement pour les installeurs livrés en archive : chemin relatif de l\'exécutable principal à l\'intérieur du .zip.</div>',
      '</div>',
      '<div class="field"><label>Remplacer le fichier .exe / .msi / .zip (optionnel)</label><input type="file" id="eFile" accept=".exe,.msi,.zip">',
      '  <div class="help">Si tu choisis un fichier ici, il sera uploadé et remplacera l\'installeur actuel (l\'ancien fichier sera supprimé).</div>',
      '</div>',
      '<div class="actions">',
      '  <button id="eCancel">Annuler</button>',
      '  <button id="eSubmit" class="primary">Enregistrer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#eCancel').onclick = function () { closeModal(bg); };
    bg.querySelector('#eSubmit').onclick = function () {
      var err = bg.querySelector('#eErr');
      err.style.display = 'none';
      var submit = bg.querySelector('#eSubmit');
      var file = bg.querySelector('#eFile').files[0];
      var patch = {
        name: bg.querySelector('#eName').value.trim(),
        version: bg.querySelector('#eVersion').value.trim(),
        vendor: bg.querySelector('#eVendor').value.trim(),
        silentArgs: bg.querySelector('#eSilent').value.trim(),
        archiveInstaller: bg.querySelector('#eArchive').value.trim(),
        arch: bg.querySelector('#eArch').value,
      };
      // Le champ installer n'est patché que s'il n'y a pas de remplacement ET
      // qu'il a été modifié manuellement par l'utilisateur. Sinon c'est
      // replaceInstaller qui le réécrit lui-même.
      var newInstaller = bg.querySelector('#eInstaller').value.trim();
      if (!file && newInstaller !== s.installer) patch.installer = newInstaller;

      // Étape 1 (optionnelle): upload du binaire de remplacement.
      submit.disabled = true; submit.textContent = file ? 'Préparation…' : 'Enregistrement…';
      var step1 = file
        ? api('requestUploadToken', { mode: 'replace', slug: slug, filename: file.name }).then(function (rt) {
            if (rt.error) return rt;
            submit.textContent = 'Upload…';
            return fetch(rt.url, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/octet-stream' }, body: file })
              .then(function (r) { return r.json(); });
          })
        : Promise.resolve({ ok: true });

      step1.then(function (r1) {
        if (r1.error) { err.textContent = r1.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Enregistrer'; return null; }
        // Étape 2: mise à jour des métadonnées (toujours faite, même sans patch
        // — c'est une no-op côté serveur si rien n'a changé).
        submit.textContent = 'Enregistrement…';
        return api('updateSoftware', { slug: slug }, patch);
      }).then(function (r2) {
        if (!r2) return;
        if (r2.error) { err.textContent = r2.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Enregistrer'; return; }
        closeModal(bg); load();
      });
    };
  }

  function deleteSoftware(slug) {
    var s = softwares.find(function (x) { return x.id === slug; });
    if (!s) return;
    if (!confirm('Supprimer définitivement ' + s.name + ' ?\n\nLe dossier ' + slug + ' et tous ses fichiers seront effacés sur le NAS.')) return;
    api('deleteSoftware', { slug: slug }).then(function (r) {
      if (r.error) { alert('Erreur: ' + r.error); return; }
      delete softSel[slug];
      load();
    });
  }

  $('addSoftBtn').onclick = openAdd;
  api('ping').then(function () {});
  load();
</script>
</body>
</html>
