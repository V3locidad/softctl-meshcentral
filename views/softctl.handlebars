<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Software Control</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { font-family: Segoe UI, Arial, sans-serif; font-size: 13px; padding: 10px; color: #222; box-sizing: border-box; display: flex; flex-direction: column; }
  h2 { margin: 0 0 10px 0; font-size: 16px; flex: 0 0 auto; }
  .bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 8px; flex: 0 0 auto; }
  .bar input[type=text] { padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  button { padding: 5px 10px; border: 1px solid #888; background: #fff; border-radius: 3px; cursor: pointer; font-size: 13px; }
  button.primary { background: #2c7be5; color: white; border-color: #2c7be5; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; background: #eee; font-size: 11px; margin-left: 6px; }
  .pill.ok { background: #d4edda; color: #155724; }
  .pill.bad { background: #f8d7da; color: #721c24; }
  .cols { display: flex; gap: 10px; flex: 1 1 auto; min-height: 0; }
  .col { flex: 1; border: 1px solid #ddd; border-radius: 4px; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .col h3 { margin: 0; padding: 8px; background: #eee; border-bottom: 1px solid #ddd; font-size: 13px; flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
  .col h3 .spacer { flex: 1; }
  .col .search { padding: 6px 8px; border-bottom: 1px solid #eee; flex: 0 0 auto; }
  .col .search input { width: 100%; box-sizing: border-box; padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  .col .body { flex: 1 1 auto; overflow: auto; min-height: 0; }
  .row { padding: 5px 10px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .row:hover { background: #f8f8ff; }
  .row.selected { background: #eef6ff; }
  .row input[type=checkbox] { flex: 0 0 auto; }
  .row .main { flex: 1; }
  .row .main .title { font-weight: 500; }
  .row .main .sub { color: #888; font-size: 11px; }
  .row .histBtn { flex: 0 0 auto; font-size: 11px; padding: 2px 8px; border: 1px solid #cfd5db; background: #f6f8fa; border-radius: 3px; cursor: pointer; }
  .row .histBtn:hover { background: #e9eef3; }
  .empty { color: #aaa; font-style: italic; padding: 12px; }
  #deployBar { margin-top: 10px; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  #deployBar .info { flex: 1; }
  #preview { margin-top: 10px; background: #111; color: #ddd; font-family: Menlo, Consolas, monospace; font-size: 12px; padding: 8px; border-radius: 4px; max-height: 220px; overflow: auto; white-space: pre-wrap; display: none; flex: 0 0 auto; }
  .badgeOs { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e2e3e5; color: #383d41; margin-right: 4px; }
  .statusDot { flex: 0 0 auto; width: 10px; height: 10px; border-radius: 50%; display: inline-block; box-shadow: 0 0 0 1px rgba(0,0,0,0.15); }
  .statusDot.on  { background: #2ecc40; }
  .statusDot.off { background: #d9534f; }
  .badgeWarn { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #fff3cd; color: #856404; margin-left: 4px; }
  .badgeArch { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e2e3e5; color: #383d41; margin-left: 4px; font-family: Menlo, Consolas, monospace; }
  .resCell { padding: 3px 6px; border-radius: 3px; font-size: 11px; display: inline-block; min-width: 60px; text-align: center; }
  .resCell.success { background: #d4edda; color: #155724; }
  .resCell.fail    { background: #f8d7da; color: #721c24; }
  .resCell.skipped { background: #ffe5b4; color: #7a4a00; }
  .resCell.pending { background: #fff3cd; color: #856404; }
  .resCell.offline { background: #e2e3e5; color: #383d41; }
  .rowActions { display: flex; gap: 4px; flex: 0 0 auto; opacity: 0; transition: opacity .1s; }
  .row:hover .rowActions { opacity: 1; }
  .rowActions button { padding: 2px 6px; font-size: 11px; }
  .modalBg { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
  .modal { background: #fff; border-radius: 6px; padding: 16px; min-width: 420px; max-width: 540px; max-height: 90vh; overflow: auto; }
  .modal h3 { margin: 0 0 12px 0; font-size: 15px; }
  .modal .field { margin-bottom: 10px; }
  .modal .field label { display: block; font-size: 12px; color: #555; margin-bottom: 3px; }
  .modal .field input[type=text], .modal .field input[type=file] { width: 100%; box-sizing: border-box; padding: 5px 7px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  .modal .field .help { color: #888; font-size: 11px; margin-top: 2px; }
  .modal .actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
  .modal .err { color: #721c24; background: #f8d7da; padding: 6px 10px; border-radius: 3px; margin-bottom: 10px; display: none; }
</style>
</head>
<body>

<h2>Software Control <span id="cfgState" class="pill">checking…</span></h2>

<div class="bar">
  <span style="flex:1"></span>
  <button id="invBtn" disabled title="Sélectionner exactement 1 poste">🔍 Inventaire poste</button>
  <button id="wingetBtn">📦 Winget</button>
  <button id="glpiAgentBtn">GLPI Agent</button>
  <button id="historyBtn">Historique</button>
  <button id="refreshBtn" class="primary">Rafraîchir</button>
</div>

<div class="cols">
  <div class="col">
    <h3>Logiciels <span id="softCount" class="pill">0</span><span class="spacer"></span><button id="addSoftBtn" class="primary">+ Ajouter</button><button id="selAllSoft">Tout</button><button id="selNoneSoft">Aucun</button></h3>
    <div class="search"><input type="text" id="softFilter" placeholder="Filtrer (nom, éditeur, version…)"></div>
    <div class="body" id="softList"><div class="empty">Chargement…</div></div>
  </div>

  <div class="col">
    <h3>Postes <span id="agentCount" class="pill">0</span><span class="spacer"></span><button id="selAllAgent">Tout</button><button id="selNoneAgent">Aucun</button></h3>
    <div class="search" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
      <select id="meshSel" style="padding:3px 6px;border:1px solid #bbb;border-radius:3px;font-size:13px;max-width:50%"></select>
      <button id="selMeshBtn">Cocher la salle</button>
      <input type="text" id="agentFilter" placeholder="Filtrer (nom, salle, OS…)" style="flex:1;min-width:150px">
      <label style="font-size:12px;display:flex;align-items:center;gap:4px;white-space:nowrap" title="N'afficher que les postes actuellement connectés"><input type="checkbox" id="onlyOnline"> Seulement allumés</label>
    </div>
    <div class="body" id="agentList"><div class="empty">Chargement…</div></div>
  </div>
</div>

<div id="deployBar">
  <div class="info">
    <span id="selSummary">0 logiciel sélectionné · 0 poste sélectionné</span>
  </div>
  <button id="dryRunBtn" disabled>Aperçu</button>
  <button id="deployBtn" class="primary" disabled>Déployer</button>
</div>

<pre id="preview"></pre>
<div id="deployResult" style="display:none;margin-top:10px;border:1px solid #ddd;border-radius:4px;padding:10px;max-height:340px;overflow:auto;flex:0 0 auto"></div>

<script>
  function $(id) { return document.getElementById(id); }
  function api(action, params, body) {
    // MC bloque les POST sur pluginadmin.ashx (même problème que dans adctl).
    // On passe TOUT en GET, le body est encodé dans la query string en JSON.
    var qs = 'action=' + encodeURIComponent(action);
    if (params) Object.keys(params).forEach(function (k) {
      qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
    });
    if (body) qs += '&payload=' + encodeURIComponent(JSON.stringify(body));
    return fetch('/pluginadmin.ashx?pin=softctl&' + qs, { credentials: 'include' }).then(function (r) { return r.json(); });
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }
  function humanSize(n) {
    if (!n) return '';
    if (n < 1024) return n + ' o';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' Ko';
    if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + ' Mo';
    return (n / 1024 / 1024 / 1024).toFixed(2) + ' Go';
  }

  var softwares = [];
  var wingetStatus = {};
  var wingetHasBootstrap = false;
  var agents = [];
  var meshes = [];
  var softSel = {};   // id -> true
  var agentSel = {};  // id -> true

  function renderSoft() {
    var q = ($('softFilter').value || '').toLowerCase().trim();
    var rows = softwares.filter(function (s) {
      if (!q) return true;
      return [s.name, s.vendor, s.version, s.installer].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    $('softCount').textContent = softwares.length;
    if (!rows.length) { $('softList').innerHTML = '<div class="empty">Aucun logiciel.</div>'; return; }
    $('softList').innerHTML = rows.map(function (s) {
      var checked = softSel[s.id] ? ' checked' : '';
      var sel = softSel[s.id] ? ' selected' : '';
      var isZip = /\.zip$/i.test(s.installer || '');
      var warn = !s.installerOk ? '<span class="badgeWarn" title="Installeur introuvable dans le dossier">installeur manquant</span>'
               : (isZip && !s.archiveInstaller) ? '<span class="badgeWarn" title="archiveInstaller non défini : chemin de l\'installeur dans le zip">chemin archive manquant</span>'
               : !s.silentArgs ? '<span class="badgeWarn" title="silentArgs non défini — installation interactive">non-silencieux</span>'
               : (isZip ? '<span class="badgeWarn" style="background:#d1ecf1;color:#0c5460" title="Sera extrait avant install">archive</span>' : '');
      var archBadge = s.arch ? '<span class="badgeArch" title="Architecture détectée">' + escapeHtml(s.arch) + '</span>' : '';
      return '<div class="row' + sel + '" data-id="' + escapeHtml(s.id) + '">'
           +   '<input type="checkbox" class="chk"' + checked + '>'
           +   '<div class="main">'
           +     '<div class="title">' + escapeHtml(s.name) + (s.version ? ' <span style="color:#888;font-weight:normal">' + escapeHtml(s.version) + '</span>' : '') + archBadge + warn + '</div>'
           +     '<div class="sub">'
           +       (s.vendor ? escapeHtml(s.vendor) + ' · ' : '')
           +       (s.installer ? escapeHtml(s.installer) + ' · ' : '')
           +       humanSize(s.size)
           +       (s.silentArgs ? ' · args: <code>' + escapeHtml(s.silentArgs) + '</code>' : '')
           +     '</div>'
           +   '</div>'
           +   '<div class="rowActions">'
           +     '<button class="editBtn" data-id="' + escapeHtml(s.id) + '">Éditer</button>'
           +     '<button class="delBtn" data-id="' + escapeHtml(s.id) + '">Suppr.</button>'
           +   '</div>'
           + '</div>';
    }).join('');
    bindRowToggle('softList', softSel, renderSoft);
    [].slice.call(document.querySelectorAll('#softList .editBtn')).forEach(function (b) {
      b.onclick = function (ev) { ev.stopPropagation(); openEdit(b.getAttribute('data-id')); };
    });
    [].slice.call(document.querySelectorAll('#softList .delBtn')).forEach(function (b) {
      b.onclick = function (ev) { ev.stopPropagation(); deleteSoftware(b.getAttribute('data-id')); };
    });
  }

  function renderAgents() {
    var q = ($('agentFilter').value || '').toLowerCase().trim();
    var meshFilter = $('meshSel').value;  // empty = all salles
    var onlyOnline = !!($('onlyOnline') && $('onlyOnline').checked);
    var rows = agents.filter(function (a) {
      if (meshFilter && a.meshid !== meshFilter) return false;
      if (onlyOnline && !a.online) return false;
      if (!q) return true;
      return [a.name, a.os, a.mesh].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    $('agentCount').textContent = rows.length + (rows.length !== agents.length ? ' / ' + agents.length : '');
    if (!rows.length) { $('agentList').innerHTML = '<div class="empty">Aucun poste.</div>'; return; }
    $('agentList').innerHTML = rows.map(function (a) {
      var checked = agentSel[a.id] ? ' checked' : '';
      var sel = agentSel[a.id] ? ' selected' : '';
      var dotCls = a.online ? 'on' : 'off';
      var dotTitle = a.online ? 'En ligne' : 'Hors-ligne';
      var ws = wingetStatus[a.id];
      var wgBadge = '';
      if (ws) {
        if (ws.hasWinget && !ws.tooOld) wgBadge = '<span class="badgeOs" style="background:#d4edda;color:#155724" title="Winget ' + escapeHtml(ws.version || '') + '">✓ winget</span>';
        else if (ws.hasWinget && ws.tooOld) wgBadge = '<span class="badgeOs" style="background:#fff3cd;color:#856404" title="Vieille version ' + escapeHtml(ws.version || '') + '">⚠ winget v' + escapeHtml(ws.version || '') + '</span>';
        else wgBadge = '<span class="badgeOs" style="background:#f8d7da;color:#721c24" title="Winget absent">✗ winget</span>';
      }
      return '<div class="row' + sel + '" data-id="' + escapeHtml(a.id) + '">'
           +   '<input type="checkbox" class="chk"' + checked + '>'
           +   '<span class="statusDot ' + dotCls + '" title="' + dotTitle + '"></span>'
           +   '<div class="main">'
           +     '<div class="title">' + escapeHtml(a.name) + '</div>'
           +     '<div class="sub">'
           +       (a.mesh ? '<span class="badgeOs" style="background:#d1ecf1;color:#0c5460">' + escapeHtml(a.mesh) + '</span>' : '')
           +       '<span class="badgeOs">' + escapeHtml(a.os || '?') + '</span>'
           +       (a.arch ? '<span class="badgeArch">' + escapeHtml(a.arch) + '</span>' : '')
           +       wgBadge
           +     '</div>'
           +   '</div>'
           +   '<button class="histBtn" data-node="' + escapeHtml(a.id) + '" data-name="' + escapeHtml(a.name) + '" title="Voir l\'historique des déploiements sur ce poste">Historique</button>'
           + '</div>';
    }).join('');
    bindRowToggle('agentList', agentSel, renderAgents);
    // Bouton "Historique" par ligne — stoppe la propagation pour ne pas
    // toggle la sélection de l'agent.
    [].slice.call(document.querySelectorAll('#agentList .histBtn')).forEach(function (btn) {
      btn.onclick = function (ev) {
        ev.stopPropagation();
        openNodeHistory(btn.getAttribute('data-node'), btn.getAttribute('data-name'));
      };
    });
  }

  function openNodeHistory(nodeId, nodeName) {
    var bg = showModal([
      '<h3>Historique — ' + escapeHtml(nodeName || nodeId) + '</h3>',
      '<div id="nhBody">Chargement…</div>',
      '<div class="actions">',
      '  <button id="nhClear" style="background:#fbe9e7;color:#8a2a17;border-color:#f5c2b8">Vider pour ce poste</button>',
      '  <button id="nhClose">Fermer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#nhClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#nhClear').onclick = function () {
      if (!confirm('Retirer ' + (nodeName || nodeId) + ' de tout l\'historique des déploiements ?')) return;
      api('clearNodeHistory', { nodeId: nodeId }).then(function (r) {
        if (r && r.ok) { closeModal(bg); openNodeHistory(nodeId, nodeName); }
        else alert('Erreur : ' + (r && r.error || 'inconnue'));
      });
    };
    // Charge en parallèle l'historique des softs et celui des GLPI Agent
    Promise.all([
      api('nodeHistory', { nodeId: nodeId }),
      api('glpiAgentHistory', { nodeId: nodeId }),
    ]).then(function (results) {
      var r = results[0] || {};
      var g = results[1] || {};
      var deps = r.deployments || [];
      var glpi = g.runs || [];
      var softHtml = '';
      if (!deps.length) {
        softHtml = '<div class="empty">Aucun déploiement de logiciel sur ce poste.</div>';
      } else {
        softHtml = deps.map(function (d) {
          var when = new Date(d.timestamp).toLocaleString();
          var items = (d.items || []).map(function (it) {
            var cls = 'pending';
            var label = it.status || 'pending';
            if (it.status === 'success') { cls = 'success'; label = 'OK'; }
            else if (it.status === 'fail') { cls = 'fail'; label = 'KO (' + (it.exitCode != null ? it.exitCode : '?') + ')'; }
            else if (it.status === 'skipped') { cls = 'skipped'; label = 'ignoré'; }
            else if (it.status === 'agent-offline') { cls = 'offline'; label = 'agent off'; }
            else if (it.status === 'dispatch-failed') { cls = 'fail'; label = 'dispatch KO'; }
            else if (it.status === 'cancelled') { cls = 'offline'; label = 'annulé'; }
            else if (it.status === 'dispatched') { cls = 'pending'; label = 'envoyé'; }
            return '<div style="margin-top:2px"><span class="resCell ' + cls + '">' + escapeHtml(label) + '</span> ' + escapeHtml(it.softName || it.softId) + '</div>';
          }).join('');
          return '<div style="padding:8px;border-bottom:1px solid #eee">'
               +   '<div><b>' + escapeHtml(when) + '</b> · par ' + escapeHtml(d.user || '?') + '</div>'
               +   items
               + '</div>';
        }).join('');
      }

      var glpiHtml = '';
      if (!glpi.length) {
        glpiHtml = '<div class="empty">Aucun déploiement de GLPI Agent sur ce poste.</div>';
      } else {
        glpiHtml = glpi.map(function (gr) {
          var when = new Date(gr.timestamp).toLocaleString();
          var st = gr.status || '?';
          var cls = 'pending', label = st;
          if (st === 'done')         { cls = 'success'; label = 'OK'; }
          else if (st === 'error')   { cls = 'fail';    label = 'KO'; }
          else if (st === 'aborted') { cls = 'fail';    label = 'abandonné'; }
          else if (st === 'offline') { cls = 'offline'; label = 'offline'; }
          else if (st === 'queued')  { cls = 'pending'; label = 'en attente (off)'; }
          else if (st === 'running') { cls = 'pending'; label = 'en cours'; }
          var versions = '';
          if (gr.installedVersion || gr.desiredVersion) {
            versions = ' · ' + escapeHtml(gr.installedVersion || '—') + ' → ' + escapeHtml(gr.desiredVersion || '—');
          }
          var detail = gr.result ? (' · ' + escapeHtml(gr.result)) : '';
          var force = gr.force ? ' · <span style="color:#c9302c">forcé</span>' : '';
          // Bouton de re-vérif : pour les runs aborted / offline où on suspecte
          // que l'install a réussi mais que le report a été perdu.
          var recheckBtn = '';
          if (st === 'aborted' || st === 'offline' || st === 'queued' || st === 'error') {
            recheckBtn = ' <button class="glpiRecheckBtn" data-rid="' + escapeHtml(gr.runId || '') + '" data-nid="' + escapeHtml(nodeId) + '" style="font-size:11px;padding:1px 6px" title="Demander à l\'agent sa version GLPI installée et mettre à jour ce run">🔁 Re-vérifier</button>';
          }
          return '<div style="padding:8px;border-bottom:1px solid #eee">'
               +   '<div><b>' + escapeHtml(when) + '</b> · par ' + escapeHtml(gr.user || '?') + force + recheckBtn + '</div>'
               +   '<div style="margin-top:2px"><span class="resCell ' + cls + '">' + escapeHtml(label) + '</span>'
               +     ' GLPI Agent' + versions + detail + '</div>'
               + '</div>';
        }).join('');
      }

      bg.querySelector('#nhBody').innerHTML =
        '<div style="margin-bottom:8px"><h4 style="margin:6px 0">Logiciels</h4>' + softHtml + '</div>'
        + '<div><h4 style="margin:6px 0">GLPI Agent</h4>' + glpiHtml + '</div>';
      [].slice.call(bg.querySelectorAll('.glpiRecheckBtn')).forEach(function (btn) {
        btn.onclick = function () {
          var rid = btn.getAttribute('data-rid');
          var nid = btn.getAttribute('data-nid');
          btn.disabled = true; btn.textContent = '…';
          api('recheckGlpiAgent', { runId: rid, nodeId: nid }).then(function (r) {
            if (r && r.error) { btn.disabled = false; btn.textContent = '🔁 Re-vérifier'; alert('Erreur : ' + r.error); return; }
            // Laisse 3 s à l'agent pour répondre, puis recharge la modale.
            setTimeout(function () { closeModal(bg); openNodeHistory(nodeId, nodeName); }, 3500);
          }).catch(function (e) { btn.disabled = false; btn.textContent = '🔁 Re-vérifier'; alert('Erreur réseau : ' + e); });
        };
      });
    });
  }

  function renderMeshSelect() {
    var opts = '<option value="">— Toutes les salles —</option>';
    meshes.forEach(function (m) {
      // Show how many agents the salle has; otherwise the dropdown is opaque.
      var count = agents.filter(function (a) { return a.meshid === m.id; }).length;
      opts += '<option value="' + escapeHtml(m.id) + '">' + escapeHtml(m.name) + ' (' + count + ')</option>';
    });
    $('meshSel').innerHTML = opts;
  }

  function bindRowToggle(containerId, selStore, rerender) {
    [].slice.call(document.querySelectorAll('#' + containerId + ' .row')).forEach(function (row) {
      row.onclick = function (ev) {
        // Ignore clicks on the checkbox itself — its native onchange will fire.
        if (ev.target && ev.target.classList && ev.target.classList.contains('chk')) return;
        var id = row.getAttribute('data-id');
        if (selStore[id]) delete selStore[id]; else selStore[id] = true;
        rerender();
        updateSummary();
      };
    });
    [].slice.call(document.querySelectorAll('#' + containerId + ' .chk')).forEach(function (chk) {
      chk.onchange = function () {
        var id = chk.parentNode.getAttribute('data-id');
        if (chk.checked) selStore[id] = true; else delete selStore[id];
        rerender();
        updateSummary();
      };
    });
  }

  function updateSummary() {
    var ns = Object.keys(softSel).length, na = Object.keys(agentSel).length;
    $('selSummary').textContent = ns + ' logiciel' + (ns > 1 ? 's' : '') + ' sélectionné' + (ns > 1 ? 's' : '')
                                + ' · ' + na + ' poste' + (na > 1 ? 's' : '') + ' sélectionné' + (na > 1 ? 's' : '');
    $('deployBtn').disabled = !(ns && na);
    $('dryRunBtn').disabled = !(ns && na);
    var inv = $('invBtn');
    if (inv) {
      inv.disabled = (na !== 1);
      inv.title = (na === 1) ? 'Voir installés + MAJ winget du poste' : 'Sélectionner exactement 1 poste';
    }
  }

  function load() {
    $('softList').innerHTML = '<div class="empty">Chargement…</div>';
    $('agentList').innerHTML = '<div class="empty">Chargement…</div>';
    api('catalog').then(function (r) {
      if (r.error) {
        $('cfgState').textContent = 'Erreur: ' + r.error;
        $('cfgState').className = 'pill bad';
        $('softList').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>';
        return;
      }
      softwares = r.softwares || [];
      $('cfgState').textContent = softwares.length + ' logiciels, ' + (r.skipped || []).length + ' ignorés';
      $('cfgState').className = 'pill ok';
      renderSoft();
    });
    api('agents').then(function (r) {
      if (r.error) {
        $('agentList').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>';
        return;
      }
      agents = r.agents || [];
      meshes = r.meshes || [];
      renderMeshSelect();
      renderAgents();
      refreshWingetStatus();
    });
  }

  function refreshWingetStatus() {
    api('wingetStatus').then(function (r) {
      wingetStatus = r.statuses || {};
      wingetHasBootstrap = !!r.hasBootstrap;
      renderAgents();
      renderWingetBanner();
    });
  }

  function renderWingetBanner() {
    var bar = document.getElementById('wgBanner');
    if (!bar) {
      bar = document.createElement('div');
      bar.id = 'wgBanner';
      bar.style.cssText = 'display:none;margin-bottom:8px;padding:8px 12px;background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;color:#856404;align-items:center;gap:10px';
      var deployBar = document.getElementById('deployBar');
      deployBar.parentNode.insertBefore(bar, deployBar);
    }
    var missing = 0, old = 0;
    agents.forEach(function (a) {
      if (!a.online) return;
      var s = wingetStatus[a.id];
      if (!s) return;
      if (!s.hasWinget) missing++;
      else if (s.tooOld) old++;
    });
    var total = missing + old;
    if (!total) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    if (wingetHasBootstrap) {
      bar.style.background = '#d1ecf1';
      bar.style.borderColor = '#bee5eb';
      bar.style.color = '#0c5460';
      bar.innerHTML = '🔧 Installation Winget automatique en cours sur ' + total + ' poste(s) (' + missing + ' manquants, ' + old + ' trop anciens)<span style="margin-left:auto;font-size:11px">Re-vérification toutes les 2 min</span>';
    } else {
      bar.style.background = '#fff3cd';
      bar.style.borderColor = '#ffeeba';
      bar.style.color = '#856404';
      bar.innerHTML = '⚠ ' + total + ' poste(s) en ligne sans Winget. Crée un soft <b>winget-bootstrap</b> au catalogue pour activer l\'install auto.';
    }
  }
  // Rafraîchit les badges toutes les 30s pour suivre l'évolution.
  setInterval(refreshWingetStatus, 30000);

  $('softFilter').oninput = renderSoft;
  $('agentFilter').oninput = renderAgents;
  if ($('onlyOnline')) $('onlyOnline').onchange = renderAgents;
  $('refreshBtn').onclick = load;
  $('selAllSoft').onclick = function () { softwares.forEach(function (s) { softSel[s.id] = true; }); renderSoft(); updateSummary(); };
  $('selNoneSoft').onclick = function () { softSel = {}; renderSoft(); updateSummary(); };
  $('selAllAgent').onclick = function () { agents.forEach(function (a) { agentSel[a.id] = true; }); renderAgents(); updateSummary(); };
  $('selNoneAgent').onclick = function () { agentSel = {}; renderAgents(); updateSummary(); };
  $('meshSel').onchange = renderAgents;
  $('selMeshBtn').onclick = function () {
    var mid = $('meshSel').value;
    if (!mid) { alert('Choisis d\'abord une salle dans le menu déroulant.'); return; }
    agents.filter(function (a) { return a.meshid === mid; }).forEach(function (a) { agentSel[a.id] = true; });
    renderAgents(); updateSummary();
  };
  $('dryRunBtn').onclick = function () {
    var body = { softIds: Object.keys(softSel), nodeIds: Object.keys(agentSel) };
    $('preview').style.display = '';
    $('preview').textContent = 'Aperçu…';
    api('dryRun', null, body).then(function (r) {
      if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
      var lines = ['— APERÇU DÉPLOIEMENT —', r.note || '', ''];
      (r.plan || []).forEach(function (p) {
        lines.push('• ' + p.software);
        lines.push('    fichier  : ' + p.installer);
        lines.push('    silent   : ' + (p.silentArgs || '(non défini — installeur interactif)'));
        lines.push('    postes   : ' + p.nodes);
        lines.push('');
      });
      $('preview').textContent = lines.join('\n');
    });
  };

  // Détecte les mismatches d'arch entre softs et postes sélectionnés.
  // Retourne une liste lisible des avertissements.
  function detectArchMismatches() {
    var picked = softwares.filter(function (s) { return softSel[s.id]; });
    var pickedAgents = agents.filter(function (a) { return agentSel[a.id]; });
    var warnings = [];
    picked.forEach(function (s) {
      if (!s.arch) return;  // soft "any" — on suppose compatible partout
      pickedAgents.forEach(function (a) {
        if (!a.arch) return;
        // x64 installer sur poste x86 = bloqué techniquement par Windows. Autres
        // combinaisons (x86 sur x64 par ex.) marchent généralement, donc on
        // n'avertit que sur les vrais conflits.
        if (s.arch === 'x64' && a.arch === 'x86') warnings.push(s.name + ' (x64) ↛ ' + a.name + ' (x86)');
        if (s.arch === 'arm64' && a.arch !== 'arm64') warnings.push(s.name + ' (arm64) ↛ ' + a.name + ' (' + a.arch + ')');
      });
    });
    return warnings;
  }

  $('deployBtn').onclick = function () {
    var ns = Object.keys(softSel).length, na = Object.keys(agentSel).length;
    var warnings = detectArchMismatches();
    var msg = 'Déployer ' + ns + ' logiciel(s) sur ' + na + ' poste(s) ?\n\n'
            + 'Les installeurs vont s\'exécuter en arrière-plan sur chaque poste avec leurs arguments silencieux.\n'
            + 'Si silentArgs est vide, l\'installeur sera interactif et un utilisateur devra cliquer côté poste.';
    if (warnings.length) {
      msg += '\n\n⚠ ATTENTION — incompatibilités d\'architecture détectées :\n  ' + warnings.slice(0, 8).join('\n  ');
      if (warnings.length > 8) msg += '\n  … (+' + (warnings.length - 8) + ' autres)';
      msg += '\n\nContinuer malgré tout ?';
    }
    if (!confirm(msg)) return;
    var body = { softIds: Object.keys(softSel), nodeIds: Object.keys(agentSel) };
    $('preview').style.display = '';
    $('preview').textContent = 'Dispatch en cours…';
    $('deployBtn').disabled = true; $('deployBtn').textContent = 'En cours…';
    api('deploy', null, body).then(function (r) {
      $('deployBtn').textContent = 'Déployer'; $('deployBtn').disabled = !(ns && na);
      if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
      // On démarre un polling sur le deploymentId pour afficher l'avancement en
      // temps réel (5s d'intervalle, on arrête au bout de 10 min).
      if (r.deploymentId) followDeployment(r.deploymentId);
      else $('preview').textContent = (r.dispatched || 0) + ' commande(s) envoyée(s).';
    });
  };

  function statusLabel(st) {
    if (st === 'success') return 'OK';
    if (st === 'fail') return 'ÉCHEC';
    if (st === 'skipped') return 'ignoré';
    if (st === 'agent-offline') return 'agent off';
    if (st === 'dispatch-failed') return 'dispatch KO';
    if (st === 'cancelled') return 'annulé';
    if (st === 'queued') return 'en attente (off)';
    return 'en cours…';
  }
  function statusClass(st) {
    if (st === 'success') return 'success';
    if (st === 'fail') return 'fail';
    if (st === 'skipped') return 'skipped';
    if (st === 'agent-offline' || st === 'dispatch-failed' || st === 'cancelled') return 'offline';
    return 'pending';
  }
  // Tâche de polling en cours : on stocke l'ID + le flag de cancel pour pouvoir
  // l'arrêter quand l'utilisateur clique Annuler ou Fermer.
  var currentFollow = { id: null, stop: false };

  function followDeployment(id) {
    currentFollow = { id: id, stop: false };
    var startedAt = Date.now();
    var maxFollowMs = 10 * 60 * 1000;
    var tick = function () {
      if (currentFollow.stop || currentFollow.id !== id) return;
      api('deployment', { id: id }).then(function (r) {
        if (r.error) { $('preview').textContent = 'Erreur: ' + r.error; return; }
        var d = r.deployment;
        if (!d) { $('preview').textContent = 'Déploiement introuvable.'; return; }
        renderDeployment(d);
        var allDone = Object.values(d.results || {}).every(function (x) {
          return x.status === 'success' || x.status === 'fail' || x.status === 'skipped' || x.status === 'agent-offline' || x.status === 'dispatch-failed' || x.status === 'cancelled';
        });
        if (!allDone && (Date.now() - startedAt) < maxFollowMs && !currentFollow.stop) {
          setTimeout(tick, 5000);
        }
      });
    };
    tick();
  }

  function renderDeployment(d) {
    var agentName = function (n) {
      if (n.name) return n.name;
      var a = agents.find(function (x) { return x.id === n.id; });
      return a ? a.name : n.id.slice(0, 12);
    };
    var html = '<div style="background:#f4f4f4;padding:8px;border-radius:4px;margin-bottom:8px;display:flex;align-items:center;gap:8px">'
             + '<div style="flex:1"><b>Déploiement</b> ' + escapeHtml(d.id) + ' par ' + escapeHtml(d.user) + ' · ' + escapeHtml(new Date(d.timestamp).toLocaleString()) + '</div>'
             + '<button id="cancelDeployBtn">Annuler les en cours</button>'
             + '<button id="closeDeployBtn">Fermer</button>'
             + '</div>';
    html += '<table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr><th style="text-align:left;padding:4px;border-bottom:1px solid #ddd">Poste</th>';
    (d.softs || []).forEach(function (s) {
      html += '<th style="text-align:left;padding:4px;border-bottom:1px solid #ddd">' + escapeHtml(s.name) + '</th>';
    });
    html += '</tr></thead><tbody>';
    (d.nodes || []).forEach(function (n) {
      html += '<tr><td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(agentName(n)) + '</td>';
      (d.softs || []).forEach(function (s) {
        var key = s.id + '|' + n.id;
        var r = (d.results || {})[key] || { status: 'pending' };
        var ec = r.exitCode != null ? ' (' + r.exitCode + ')' : '';
        var hasDetail = !!(r.error || r.log);
        var title = r.error ? ' title="' + escapeHtml(r.error) + (hasDetail ? ' — cliquer pour le log complet' : '') + '"' : (hasDetail ? ' title="cliquer pour le log"' : '');
        var dataDet = hasDetail ? ' data-detail="' + escapeHtml(JSON.stringify({ soft: s.name, node: agentName(n), status: r.status, exitCode: r.exitCode, error: r.error || '', log: r.log || '' })) + '"' : '';
        var style = hasDetail ? ' style="cursor:pointer"' : '';
        html += '<td style="padding:4px;border-bottom:1px solid #f0f0f0"><span class="resCell ' + statusClass(r.status) + '"' + title + dataDet + style + '>' + statusLabel(r.status) + ec + '</span></td>';
      });
      html += '</tr>';
    });
    html += '</tbody></table>';
    var div = $('deployResult');
    div.style.display = '';
    div.innerHTML = html;
    $('preview').style.display = 'none';
    // Clic sur une cellule de résultat → modale avec le log winget complet.
    [].slice.call(div.querySelectorAll('[data-detail]')).forEach(function (el) {
      el.onclick = function () {
        try {
          var d = JSON.parse(el.getAttribute('data-detail'));
          var bg = showModal([
            '<h3>Détail — ' + escapeHtml(d.node) + '</h3>',
            '<div style="font-size:12px;color:#666;margin-bottom:6px">' + escapeHtml(d.soft) + ' · status: ' + escapeHtml(d.status) + (d.exitCode != null ? ' · exit ' + d.exitCode : '') + '</div>',
            (d.error ? '<div style="background:#f8d7da;color:#721c24;padding:6px 8px;border-radius:4px;margin-bottom:6px"><b>Erreur:</b> ' + escapeHtml(d.error) + '</div>' : ''),
            '<div style="font-size:11px;color:#666;margin-bottom:2px">Log (dernières lignes):</div>',
            '<pre style="background:#1e1e1e;color:#d4d4d4;padding:8px;border-radius:4px;max-height:50vh;overflow:auto;font-size:11px;white-space:pre-wrap">' + escapeHtml(d.log || '(aucun log)') + '</pre>',
            '<div class="actions"><button id="dClose">Fermer</button></div>',
          ].join(''));
          bg.querySelector('#dClose').onclick = function () { closeModal(bg); };
        } catch (e) {}
      };
    });
    document.getElementById('cancelDeployBtn').onclick = function () {
      if (!confirm('Marquer les installations en attente comme annulées ?\n\n(Note: les installs déjà en cours sur les postes vont à leur terme — Windows ne se laisse pas interrompre proprement à distance.)')) return;
      api('cancelDeployment', { id: d.id }).then(function () {
        currentFollow.stop = true;
        followDeployment(d.id);  // un dernier tick pour rafraîchir
      });
    };
    document.getElementById('closeDeployBtn').onclick = function () {
      currentFollow.stop = true;
      div.style.display = 'none';
      div.innerHTML = '';
    };
  }

  function openHistory() {
    var bg = showModal([
      '<h3>Historique des déploiements</h3>',
      '<div id="histBody">Chargement…</div>',
      '<div class="actions">',
      '  <button id="hClear" style="background:#fbe9e7;color:#8a2a17;border-color:#f5c2b8">Vider l\'historique</button>',
      '  <button id="hClose">Fermer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#hClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#hClear').onclick = function () {
      if (!confirm('Vider tout l\'historique des déploiements ? Cette action est irréversible.')) return;
      api('clearHistory').then(function (r) {
        if (r && r.ok) { closeModal(bg); openHistory(); }
        else alert('Erreur : ' + (r && r.error || 'inconnue'));
      });
    };
    api('history').then(function (r) {
      var rows = (r.deployments || []).map(function (d) {
        var c = d.counts || {};
        var when = new Date(d.timestamp).toLocaleString();
        var softs = (d.softs || []).map(function (s) { return s.name; }).join(', ');
        return '<div style="padding:6px 8px;border-bottom:1px solid #f0f0f0;cursor:pointer" data-id="' + escapeHtml(d.id) + '">'
             + '<div><b>' + escapeHtml(when) + '</b> · ' + escapeHtml(d.user) + '</div>'
             + '<div style="color:#666;font-size:11px;margin-top:2px">' + escapeHtml(softs.slice(0, 100)) + (softs.length > 100 ? '…' : '') + '</div>'
             + '<div style="margin-top:4px">'
             +   '<span class="resCell success">' + c.success + ' OK</span> '
             +   '<span class="resCell fail">' + c.fail + ' KO</span> '
             +   '<span class="resCell skipped">' + (c.skipped || 0) + ' ignoré</span> '
             +   '<span class="resCell pending">' + c.pending + ' attente</span> '
             +   '<span class="resCell offline">' + c.offline + ' off</span>'
             + '</div></div>';
      }).join('');
      bg.querySelector('#histBody').innerHTML = rows || '<div class="empty">Pas encore de déploiement.</div>';
      [].slice.call(bg.querySelectorAll('[data-id]')).forEach(function (el) {
        el.onclick = function () {
          var id = el.getAttribute('data-id');
          closeModal(bg);
          followDeployment(id);
        };
      });
    });
  }
  $('historyBtn').onclick = openHistory;

  // ---- Catalogue Winget ----
  // Modale dédiée : charge winget-catalog.json côté serveur, affiche les apps
  // groupées par catégorie avec checkboxes, et lance wingetDeploy sur les
  // postes déjà cochés dans la vue principale.
  function openWinget() {
    var nodeIds = Object.keys(agentSel);
    if (!nodeIds.length) {
      alert('Sélectionne d\'abord un ou plusieurs postes dans la vue principale.');
      return;
    }
    var bg = showModal([
      '<h3>📦 Catalogue Winget <span class="pill">' + nodeIds.length + ' poste(s)</span></h3>',
      '<div style="font-size:12px;color:#666;margin:0 0 8px 0">Installation silencieuse via winget (Windows 10 1809+/Windows 11). Sources : catalogue local + recherche en ligne (dépôt Microsoft).</div>',
      '<div style="display:flex;gap:6px;margin:0 0 6px 0">',
      '  <button id="wTabLocal" class="primary" style="flex:1">📚 Catalogue</button>',
      '  <button id="wTabSearch" style="flex:1">🔎 Recherche en ligne</button>',
      '  <button id="wUpgradeAll" style="background:#fff3cd;border-color:#ffe69c">⬆ Tout mettre à jour</button>',
      '</div>',
      '<div class="search"><input type="text" id="wFilter" placeholder="Filtrer le catalogue…"></div>',
      '<div id="wSearchBar" style="display:none;margin-bottom:4px">',
      '  <input type="text" id="wSearch" placeholder="Rechercher (ex: spotify, vscode, gimp…)" style="width:100%;padding:5px;border:1px solid #bbb;border-radius:3px;font-size:13px">',
      '</div>',
      '<div id="wBody" style="max-height:50vh;overflow:auto;border:1px solid #eee;border-radius:4px;padding:4px">Chargement…</div>',
      '<div class="actions">',
      '  <span id="wCount" style="margin-right:auto;color:#666">0 sélectionné(s)</span>',
      '  <label style="font-size:12px;color:#666;display:flex;align-items:center;gap:4px" title="Ajoute --force à winget. Utile pour réinstaller par-dessus une version posée hors winget (ex: Chrome MSI Google) afin que winget reprenne la main.">',
      '    <input type="checkbox" id="wForce"> Forcer',
      '  </label>',
      '  <button id="wUninstall">Désinstaller</button>',
      '  <button id="wUpgrade">⬆ Mettre à jour</button>',
      '  <button id="wInstall" class="primary">Installer</button>',
      '  <button id="wClose">Fermer</button>',
      '</div>',
    ].join(''));

    var sel = {};       // packageId -> { id, name } (préserve le nom même quand l'élément quitte la liste)
    var allApps = [];   // catalogue local
    var searchHits = [];// derniers résultats recherche en ligne
    var tab = 'local';
    var searchTimer = null;

    function bindCheckboxes() {
      [].slice.call(bg.querySelectorAll('#wBody input[type=checkbox]')).forEach(function (cb) {
        cb.onchange = function () {
          var pkg = cb.getAttribute('data-pkg');
          var name = cb.getAttribute('data-name') || pkg;
          if (cb.checked) sel[pkg] = { id: pkg, name: name }; else delete sel[pkg];
          bg.querySelector('#wCount').textContent = Object.keys(sel).length + ' sélectionné(s)';
        };
      });
    }

    function renderLocal() {
      var f = (bg.querySelector('#wFilter').value || '').trim().toLowerCase();
      var html = allApps.map(function (cat) {
        var apps = cat.apps.filter(function (a) {
          if (!f) return true;
          return (a.name + ' ' + a.id).toLowerCase().indexOf(f) !== -1;
        });
        if (!apps.length) return '';
        return '<div style="margin:6px 0 2px;font-weight:bold;color:#444">' + escapeHtml(cat.name) + '</div>'
          + apps.map(function (a) {
            var checked = sel[a.id] ? ' checked' : '';
            return '<label style="display:block;padding:3px 6px;cursor:pointer">'
              + '<input type="checkbox" data-pkg="' + escapeHtml(a.id) + '" data-name="' + escapeHtml(a.name) + '"' + checked + '> '
              + escapeHtml(a.name)
              + ' <span style="color:#999;font-size:11px">' + escapeHtml(a.id) + '</span></label>';
          }).join('');
      }).join('');
      bg.querySelector('#wBody').innerHTML = html || '<div class="empty">Aucun résultat.</div>';
      bindCheckboxes();
    }

    function renderSearch() {
      var rows = searchHits.map(function (a) {
        var checked = sel[a.id] ? ' checked' : '';
        return '<label style="display:block;padding:4px 6px;border-bottom:1px solid #f3f3f3;cursor:pointer">'
          + '<input type="checkbox" data-pkg="' + escapeHtml(a.id) + '" data-name="' + escapeHtml(a.name) + '"' + checked + '> '
          + '<b>' + escapeHtml(a.name) + '</b>'
          + (a.version ? ' <span style="color:#666">' + escapeHtml(a.version) + '</span>' : '')
          + ' <span style="color:#999;font-size:11px">' + escapeHtml(a.id) + '</span>'
          + (a.publisher ? '<div style="color:#888;font-size:11px;margin-left:22px">' + escapeHtml(a.publisher) + '</div>' : '')
          + '</label>';
      }).join('');
      bg.querySelector('#wBody').innerHTML = rows || '<div class="empty">Tape au moins 2 caractères.</div>';
      bindCheckboxes();
    }

    function doSearch() {
      var q = (bg.querySelector('#wSearch').value || '').trim();
      if (q.length < 2) { searchHits = []; renderSearch(); return; }
      bg.querySelector('#wBody').innerHTML = '<div class="empty">Recherche…</div>';
      api('wingetSearch', { q: q }).then(function (r) {
        if (r.error) { bg.querySelector('#wBody').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>'; return; }
        searchHits = r.results || [];
        renderSearch();
      });
    }

    function switchTab(which) {
      tab = which;
      bg.querySelector('#wTabLocal').className = (which === 'local') ? 'primary' : '';
      bg.querySelector('#wTabSearch').className = (which === 'search') ? 'primary' : '';
      bg.querySelector('#wFilter').parentNode.style.display = (which === 'local') ? '' : 'none';
      bg.querySelector('#wSearchBar').style.display = (which === 'search') ? '' : 'none';
      if (which === 'local') renderLocal(); else { searchHits = []; renderSearch(); bg.querySelector('#wSearch').focus(); }
    }

    bg.querySelector('#wClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#wFilter').oninput = renderLocal;
    bg.querySelector('#wTabLocal').onclick = function () { switchTab('local'); };
    bg.querySelector('#wTabSearch').onclick = function () { switchTab('search'); };
    bg.querySelector('#wSearch').oninput = function () {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(doSearch, 500);
    };

    function dispatch(mode, btnSel) {
      var force = !!bg.querySelector('#wForce').checked;
      var body = { nodeIds: nodeIds, mode: mode, force: force };
      var verb;
      if (mode === 'upgrade-all') {
        verb = 'mettre à jour TOUS les paquets';
      } else {
        var pkgs = Object.keys(sel);
        if (!pkgs.length) { alert('Sélectionne au moins une app.'); return; }
        body.packageIds = pkgs;
        verb = (mode === 'uninstall') ? 'désinstaller'
             : (mode === 'upgrade') ? 'mettre à jour'
             : 'installer';
        verb += ' ' + pkgs.length + ' app(s)';
      }
      if (!confirm('Confirmer : ' + verb + ' sur ' + nodeIds.length + ' poste(s) ?')) return;
      var btn = bg.querySelector(btnSel);
      var prev = btn.textContent;
      btn.disabled = true; btn.textContent = 'Envoi…';
      api('wingetDeploy', null, body).then(function (r) {
        btn.disabled = false; btn.textContent = prev;
        if (r.error) { alert('Erreur : ' + r.error); return; }
        closeModal(bg);
        if (r.deploymentId) followDeployment(r.deploymentId);
      }).catch(function (e) {
        btn.disabled = false; btn.textContent = prev;
        alert('Erreur : ' + e);
      });
    }
    bg.querySelector('#wInstall').onclick    = function () { dispatch('install',     '#wInstall'); };
    bg.querySelector('#wUninstall').onclick  = function () { dispatch('uninstall',   '#wUninstall'); };
    bg.querySelector('#wUpgrade').onclick    = function () { dispatch('upgrade',     '#wUpgrade'); };
    bg.querySelector('#wUpgradeAll').onclick = function () { dispatch('upgrade-all', '#wUpgradeAll'); };

    api('wingetCatalog').then(function (r) {
      if (r.error) { bg.querySelector('#wBody').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>'; return; }
      allApps = r.categories || [];
      renderList();
    });
  }
  $('wingetBtn').onclick = openWinget;

  function openGlpiAgent() {
    var nodeIds = Object.keys(agentSel);
    if (!nodeIds.length) { alert('Sélectionne d\'abord un ou plusieurs postes.'); return; }
    var bg = showModal([
      '<h3>Déploiement GLPI Agent <span class="pill">' + nodeIds.length + ' poste(s)</span></h3>',
      '<div style="font-size:12px;color:#666;margin:0 0 8px 0">',
      '  Le serveur sélectionne automatiquement le MSI le plus récent de <code>plugins/softctl/bin/GLPI-Agent*.msi</code>.',
      '  Pour chaque poste : si non installé → install ; si version < cible → MAJ ; sinon → skip + inventaire <i>--force</i>.',
      '</div>',
      '<label style="display:flex;align-items:center;gap:6px;font-size:12px;color:#444;margin-bottom:8px;cursor:pointer">',
      '  <input type="checkbox" id="glpiForce">',
      '  <span><b>Forcer la (ré)installation/MAJ</b> — ignore le check de version, relance msiexec même si déjà à jour</span>',
      '</label>',
      '<div id="glpiBody" style="max-height:50vh;overflow:auto;border:1px solid #eee;border-radius:4px;padding:8px">Prêt à déployer.</div>',
      '<div class="actions">',
      '  <button id="glpiClose">Fermer</button>',
      '  <button id="glpiGo" class="primary">Déployer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#glpiClose').onclick = function () { closeModal(bg); };
    bg.querySelector('#glpiGo').onclick = function () {
      var force = bg.querySelector('#glpiForce').checked;
      bg.querySelector('#glpiGo').disabled = true;
      bg.querySelector('#glpiBody').innerHTML = '<div style="color:#666">Dispatch en cours…</div>';
      api('glpiAgentDeploy', null, { nodes: nodeIds, force: force })
        .then(function (r) {
          if (r.error) { bg.querySelector('#glpiBody').innerHTML = '<div style="color:#721c24">⚠ ' + escapeHtml(r.error) + '</div>'; return; }
          pollGlpiRun(r.runId, r.dispatched, r.offline, bg, r.queued || 0);
        })
        .catch(function (e) {
          bg.querySelector('#glpiBody').innerHTML = '<div style="color:#721c24">⚠ ' + escapeHtml(e.message) + '</div>';
        });
    };
  }
  function pollGlpiRun(runId, dispatched, offline, bg, queued) {
    queued = queued || 0;
    api('glpiAgentStatus', { runId: runId })
      .then(function (run) {
        var byId = {};
        agents.forEach(function (a) { byId[a.id] = a; });
        var rows = Object.keys(run.results).map(function (nid) {
          var r = run.results[nid];
          var a = byId[nid] || {};
          var st;
          if (r.status === 'running')      st = '<span style="background:#fff3cd;padding:1px 6px;border-radius:3px;font-size:11px">en cours</span>';
          else if (r.status === 'queued')  st = '<span style="background:#fff3cd;color:#856404;padding:1px 6px;border-radius:3px;font-size:11px" title="L\'install se lancera dès que le poste reviendra en ligne">en attente (off)</span>';
          else if (r.status === 'done')    st = '<span style="background:#d4edda;color:#155724;padding:1px 6px;border-radius:3px;font-size:11px">' + escapeHtml(r.result || 'OK') + '</span>';
          else if (r.status === 'offline') st = '<span style="background:#e2e3e5;color:#383d41;padding:1px 6px;border-radius:3px;font-size:11px">offline</span>';
          else if (r.status === 'aborted') st = '<span style="background:#f8d7da;color:#721c24;padding:1px 6px;border-radius:3px;font-size:11px" title="' + escapeHtml(r.error || '') + '">abandonné</span>';
          else                              st = '<span style="background:#f8d7da;color:#721c24;padding:1px 6px;border-radius:3px;font-size:11px" title="' + escapeHtml(r.error || '') + '">erreur</span>';
          var instV = r.installedVersion || '';
          var desV = r.desiredVersion || '';
          return '<tr>'
            + '<td style="padding:3px 6px">' + escapeHtml(a.name || nid.slice(0, 12)) + '</td>'
            + '<td style="padding:3px 6px">' + st + '</td>'
            + '<td style="padding:3px 6px;font-family:Menlo,Consolas,monospace;font-size:11px">' + (instV ? escapeHtml(instV) : '—') + '</td>'
            + '<td style="padding:3px 6px;font-family:Menlo,Consolas,monospace;font-size:11px">' + (desV ? escapeHtml(desV) : '—') + '</td>'
            + '<td style="padding:3px 6px;font-size:11px;color:#666">' + escapeHtml(r.error || '') + '</td>'
            + '</tr>';
        }).join('');
        bg.querySelector('#glpiBody').innerHTML =
          '<div style="font-size:11px;color:#888;margin-bottom:6px">Run ' + runId
          + (run.desiredVersion ? ' · MSI cible <b>' + escapeHtml(run.desiredVersion) + '</b>' : '')
          + (run.force ? ' · <span style="color:#c9302c">forcé</span>' : '')
          + ' · ' + dispatched + ' dispatché(s)' + (queued ? ' · ' + queued + ' en attente (PC éteints)' : '') + (offline && !queued ? ' · ' + offline + ' offline' : '') + '</div>'
          + '<table style="width:100%;border-collapse:collapse;font-size:12px">'
          + '<thead><tr style="background:#f4f4f4;text-align:left">'
          + '<th style="padding:5px">Poste</th>'
          + '<th style="padding:5px">Statut</th>'
          + '<th style="padding:5px">Avant</th>'
          + '<th style="padding:5px">Cible</th>'
          + '<th style="padding:5px">Détail</th>'
          + '</tr></thead>'
          + '<tbody>' + rows + '</tbody></table>';
        var pending = Object.values(run.results).some(function (r) { return r.status === 'running' || r.status === 'queued'; });
        if (pending) setTimeout(function () { pollGlpiRun(runId, dispatched, offline, bg, queued); }, 4000);
      })
      .catch(function () { setTimeout(function () { pollGlpiRun(runId, dispatched, offline, bg, queued); }, 6000); });
  }
  $('glpiAgentBtn').onclick = openGlpiAgent;

  function openInventory() {
    var nodeIds = Object.keys(agentSel);
    if (nodeIds.length !== 1) return;
    var nodeId = nodeIds[0];
    var ag = agents.find(function (a) { return a.id === nodeId; });
    var label = ag ? ag.name : nodeId.slice(0, 12);
    var headHtml =
      '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
      + '<h3 style="margin:0;flex:1">🔍 Inventaire winget — ' + escapeHtml(label) + '</h3>'
      + '<button id="invRefresh">Rafraîchir</button>'
      + '<button id="invClose">Fermer</button>'
      + '</div>';
    var body = '<div id="invBody"><div class="empty">Interrogation de l\'agent…</div></div>';
    var bg = showModal(headHtml + body);
    bg.querySelector('.modal').style.maxWidth = '920px';
    bg.querySelector('.modal').style.width = '95%';
    bg.querySelector('#invClose').onclick = function () { closeModal(bg); };

    function fetchAndRender() {
      var box = bg.querySelector('#invBody');
      box.innerHTML = '<div class="empty">Interrogation de l\'agent (jusqu\'à 3 min)…</div>';
      api('wingetInventory', { nodeId: nodeId }).then(function (r) {
        if (!r.ok) {
          var html = '<div class="empty" style="color:#721c24">Erreur : ' + escapeHtml(r.error || 'inconnue') + '</div>';
          // Si l'erreur indique winget absent ET que le catalogue contient un
          // soft "winget-bootstrap", on propose un bouton d'install auto.
          if (/winget non install|App Installer requis/i.test(r.error || '')) {
            var hasBootstrap = (softwares || []).some(function (s) { return s.id === 'winget-bootstrap'; });
            if (hasBootstrap) {
              html += '<div style="padding:10px;text-align:center"><button id="bootBtn" class="primary">⚙ Installer Winget via NAS</button></div>';
            } else {
              html += '<div style="padding:10px;text-align:center;color:#666;font-size:11px">Ajoute un soft <b>winget-bootstrap</b> au catalogue NAS pour activer l\'install automatique.</div>';
            }
          }
          box.innerHTML = html;
          var bootBtn = document.getElementById('bootBtn');
          if (bootBtn) {
            bootBtn.onclick = function () {
              bootBtn.disabled = true;
              box.innerHTML = '<div class="empty">📥 Déploiement Winget Bootstrap depuis le NAS…<br><br>Téléchargement + DISM (2-5 min). Re-cliquera l\'inventaire à la fin.</div>';
              api('deploy', null, { softIds: ['winget-bootstrap'], nodeIds: [nodeId] }).then(function (r2) {
                if (r2.error) { box.innerHTML = '<div class="empty" style="color:#721c24">Erreur déploiement : ' + escapeHtml(r2.error) + '</div>'; return; }
                // Poll le déploiement jusqu'à terminaison, puis retry l'inventaire.
                var depId = r2.deploymentId;
                var poll = setInterval(function () {
                  api('deployment', { id: depId }).then(function (d) {
                    if (!d || !d.deployment) return;
                    var key = 'winget-bootstrap|' + nodeId;
                    var res = (d.deployment.results || {})[key];
                    if (res && (res.status === 'success' || res.status === 'fail' || res.status === 'skipped')) {
                      clearInterval(poll);
                      if (res.status === 'success' || res.status === 'skipped') {
                        // Relance l'inventaire (winget devrait être là maintenant)
                        fetchAndRender();
                      } else {
                        box.innerHTML = '<div class="empty" style="color:#721c24">Bootstrap KO : ' + escapeHtml(res.error || ('exit ' + res.exitCode)) + '</div>';
                      }
                    }
                  });
                }, 4000);
              });
            };
          }
          return;
        }
        var installed = r.installed || [];
        var upgrades = r.upgrades || [];
        // Filtre installed = lignes avec Id non vide ; idem upgrades
        function colName(row, candidates) {
          for (var i = 0; i < candidates.length; i++) if (row[candidates[i]] != null) return candidates[i];
          return null;
        }
        function renderTable(rows, mode) {
          if (!rows.length) return '<div class="empty">Aucun.</div>';
          var nameC = colName(rows[0], ['Name', 'Nom']);
          var idC   = colName(rows[0], ['Id', 'ID']);
          var verC  = colName(rows[0], ['Version']);
          var avC   = colName(rows[0], ['Available', 'Disponible', 'Disponibilité']);
          var srcC  = colName(rows[0], ['Source']);
          var html = '<table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr>'
                   + '<th style="text-align:left;padding:4px;border-bottom:2px solid #ccc">Nom</th>'
                   + '<th style="text-align:left;padding:4px;border-bottom:2px solid #ccc">Id</th>'
                   + '<th style="text-align:left;padding:4px;border-bottom:2px solid #ccc">Version</th>'
                   + (mode === 'upgrade' ? '<th style="text-align:left;padding:4px;border-bottom:2px solid #ccc">→ Disponible</th>' : '')
                   + '<th style="text-align:left;padding:4px;border-bottom:2px solid #ccc">Source</th>'
                   + '<th style="padding:4px;border-bottom:2px solid #ccc">Action</th>'
                   + '</tr></thead><tbody>';
          rows.forEach(function (row) {
            var id = idC ? row[idC] : '';
            if (!id) return;
            var name = nameC ? row[nameC] : '';
            var ver = verC ? row[verC] : '';
            var av = avC ? row[avC] : '';
            var src = srcC ? row[srcC] : '';
            html += '<tr>'
                  + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(name) + '</td>'
                  + '<td style="padding:4px;border-bottom:1px solid #f0f0f0;font-family:monospace;font-size:12px">' + escapeHtml(id) + '</td>'
                  + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(ver) + '</td>'
                  + (mode === 'upgrade' ? '<td style="padding:4px;border-bottom:1px solid #f0f0f0;color:#0a6b1a;font-weight:bold">' + escapeHtml(av) + '</td>' : '')
                  + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(src) + '</td>'
                  + '<td style="padding:4px;border-bottom:1px solid #f0f0f0;text-align:right">'
                  + (mode === 'upgrade'
                      ? '<button class="invAct" data-pkg="' + escapeHtml(id) + '" data-mode="upgrade">⬆ MAJ</button>'
                      : '<button class="invAct" data-pkg="' + escapeHtml(id) + '" data-mode="uninstall">Désinst.</button>')
                  + '</td>'
                  + '</tr>';
          });
          html += '</tbody></table>';
          return html;
        }
        var upgHead = '<div style="margin:8px 0 4px 0;font-weight:bold">⬆ Mises à jour disponibles <span class="pill">' + upgrades.length + '</span>'
                    + (upgrades.length ? ' <button id="invUpgAll" style="margin-left:8px">⬆ Tout mettre à jour</button>' : '')
                    + '</div>';
        var insHead = '<div style="margin:14px 0 4px 0;font-weight:bold">📚 Logiciels installés <span class="pill">' + installed.length + '</span></div>';
        var rawDump = '';
        if ((!installed.length || !upgrades.length) && (r.rawList || r.rawUpgrade)) {
          rawDump = '<details style="margin-top:12px"><summary style="cursor:pointer;color:#666">🐛 Sortie brute winget (diagnostic)</summary>'
                  + '<div style="font-weight:bold;margin-top:6px">winget list :</div>'
                  + '<pre style="background:#1e1e1e;color:#eee;padding:8px;border-radius:4px;max-height:200px;overflow:auto;font-size:12px">' + escapeHtml(r.rawList || '(vide)') + '</pre>'
                  + '<div style="font-weight:bold;margin-top:6px">winget upgrade :</div>'
                  + '<pre style="background:#1e1e1e;color:#eee;padding:8px;border-radius:4px;max-height:200px;overflow:auto;font-size:12px">' + escapeHtml(r.rawUpgrade || '(vide)') + '</pre>'
                  + '</details>';
        }
        box.innerHTML = upgHead + renderTable(upgrades, 'upgrade') + insHead + renderTable(installed, 'installed') + rawDump;

        function dispatchAction(mode, packageIds) {
          if (!confirm('Confirmer : ' + mode + ' ' + (packageIds[0] === '*' ? '(tout)' : packageIds.join(', ')) + ' sur ' + label + ' ?')) return;
          var body = { nodeIds: [nodeId], mode: mode, force: false };
          if (packageIds[0] === '*') body.packageIds = ['*']; else body.packageIds = packageIds;
          api('wingetDeploy', null, body).then(function (rr) {
            if (rr.error) { alert('Erreur: ' + rr.error); return; }
            closeModal(bg);
            if (rr.deploymentId) followDeployment(rr.deploymentId);
          });
        }
        Array.prototype.forEach.call(box.querySelectorAll('.invAct'), function (btn) {
          btn.onclick = function () { dispatchAction(btn.getAttribute('data-mode'), [btn.getAttribute('data-pkg')]); };
        });
        var upgAll = box.querySelector('#invUpgAll');
        if (upgAll) upgAll.onclick = function () { dispatchAction('upgrade-all', ['*']); };
      });
    }
    bg.querySelector('#invRefresh').onclick = fetchAndRender;
    fetchAndRender();
  }
  $('invBtn').onclick = openInventory;

  // ---- modal helpers ----
  function showModal(html) {
    var bg = document.createElement('div');
    bg.className = 'modalBg';
    bg.innerHTML = '<div class="modal">' + html + '</div>';
    document.body.appendChild(bg);
    bg.onclick = function (e) { if (e.target === bg) document.body.removeChild(bg); };
    return bg;
  }
  function closeModal(bg) { if (bg && bg.parentNode) bg.parentNode.removeChild(bg); }

  function openAdd() {
    var bg = showModal([
      '<h3>Ajouter un logiciel</h3>',
      '<div class="err" id="addErr"></div>',
      '<div class="field"><label>Nom *</label><input type="text" id="aName" placeholder="Notepad++"></div>',
      '<div style="display:flex;gap:8px">',
      '  <div class="field" style="flex:1"><label>Version</label><input type="text" id="aVersion" placeholder="8.6"></div>',
      '  <div class="field" style="flex:1"><label>Éditeur</label><input type="text" id="aVendor" placeholder="Don Ho"></div>',
      '</div>',
      '<div class="field"><label>Arguments silencieux</label><input type="text" id="aSilent" placeholder="/S">',
      '  <div class="help">Ex : <code>/S</code> (NSIS), <code>/quiet /norestart</code> (MSI), <code>/qn</code>, <code>--silent</code>, …</div>',
      '</div>',
      '<div class="field"><label>Installeur (.exe / .msi / .zip) *</label><input type="file" id="aFile" accept=".exe,.msi,.zip">',
      '  <div class="help">Le fichier sera copié sur le NAS. Si tu choisis un .zip, l\'archive sera extraite côté poste avant l\'install.</div>',
      '</div>',
      '<div class="field"><label>Chemin dans le .zip (si applicable)</label><input type="text" id="aArchive" placeholder="Anagene/setup.exe">',
      '  <div class="help">Pour un installeur multi-fichiers livré en .zip : chemin relatif de l\'exécutable principal à l\'intérieur de l\'archive.</div>',
      '</div>',
      '<div class="actions">',
      '  <button id="aCancel">Annuler</button>',
      '  <button id="aSubmit" class="primary">Ajouter</button>',
      '</div>',
    ].join(''));
    var cancel = function () { closeModal(bg); };
    bg.querySelector('#aCancel').onclick = cancel;
    bg.querySelector('#aSubmit').onclick = function () {
      var name = bg.querySelector('#aName').value.trim();
      var file = bg.querySelector('#aFile').files[0];
      var err = bg.querySelector('#addErr');
      err.style.display = 'none';
      if (!name) { err.textContent = 'Nom requis.'; err.style.display = 'block'; return; }
      if (!file) { err.textContent = 'Installeur requis.'; err.style.display = 'block'; return; }
      var params = {
        mode: 'add',
        name: name,
        version: bg.querySelector('#aVersion').value.trim(),
        vendor: bg.querySelector('#aVendor').value.trim(),
        silentArgs: bg.querySelector('#aSilent').value.trim(),
        filename: file.name,
        archiveInstaller: bg.querySelector('#aArchive').value.trim(),
      };
      var submit = bg.querySelector('#aSubmit');
      submit.disabled = true; submit.textContent = 'Préparation…';
      // Étape 1 : récupère un token + URL via GET (pluginadmin).
      api('requestUploadToken', params).then(function (r1) {
        if (r1.error) { err.textContent = r1.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Ajouter'; return null; }
        submit.textContent = 'Upload…';
        // Étape 2 : PUT le fichier sur l'endpoint custom (hors pluginadmin).
        return fetch(r1.url, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/octet-stream' }, body: file })
          .then(function (r) { return r.json(); });
      }).then(function (r2) {
        if (!r2) return;
        if (r2.error) { err.textContent = r2.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Ajouter'; return; }
        closeModal(bg); load();
      });
    };
  }

  function openEdit(slug) {
    var s = softwares.find(function (x) { return x.id === slug; });
    if (!s) return;
    var bg = showModal([
      '<h3>Éditer ' + escapeHtml(s.name) + '</h3>',
      '<div class="err" id="eErr"></div>',
      '<div class="field"><label>Nom *</label><input type="text" id="eName" value="' + escapeHtml(s.name) + '"></div>',
      '<div style="display:flex;gap:8px">',
      '  <div class="field" style="flex:1"><label>Version</label><input type="text" id="eVersion" value="' + escapeHtml(s.version) + '"></div>',
      '  <div class="field" style="flex:1"><label>Éditeur</label><input type="text" id="eVendor" value="' + escapeHtml(s.vendor) + '"></div>',
      '</div>',
      '<div class="field"><label>Arguments silencieux</label><input type="text" id="eSilent" value="' + escapeHtml(s.silentArgs) + '"></div>',
      '<div class="field"><label>Fichier installeur (nom)</label><input type="text" id="eInstaller" value="' + escapeHtml(s.installer) + '">',
      '  <div class="help">Nom du fichier dans le dossier. Pour le remplacer par un nouveau binaire, utilise le champ ci-dessous.</div>',
      '</div>',
      '<div class="field"><label>Architecture</label>',
      '  <select id="eArch">',
      '    <option value=""' + (!s.arch ? ' selected' : '') + '>Auto / Toutes</option>',
      '    <option value="x86"' + (s.arch === 'x86' ? ' selected' : '') + '>x86 (32-bit)</option>',
      '    <option value="x64"' + (s.arch === 'x64' ? ' selected' : '') + '>x64 (64-bit)</option>',
      '    <option value="arm64"' + (s.arch === 'arm64' ? ' selected' : '') + '>ARM64</option>',
      '  </select>',
      '  <div class="help">Sert à filtrer/avertir quand l\'arch du poste ne correspond pas. "Auto" devine depuis le nom de fichier.</div>',
      '</div>',
      '<div class="field"><label>Chemin dans le .zip (si applicable)</label><input type="text" id="eArchive" value="' + escapeHtml(s.archiveInstaller || '') + '" placeholder="Anagene/setup.exe">',
      '  <div class="help">Uniquement pour les installeurs livrés en archive : chemin relatif de l\'exécutable principal à l\'intérieur du .zip.</div>',
      '</div>',
      '<div class="field"><label>Remplacer le fichier .exe / .msi / .zip (optionnel)</label><input type="file" id="eFile" accept=".exe,.msi,.zip">',
      '  <div class="help">Si tu choisis un fichier ici, il sera uploadé et remplacera l\'installeur actuel (l\'ancien fichier sera supprimé).</div>',
      '</div>',
      '<div class="actions">',
      '  <button id="eCancel">Annuler</button>',
      '  <button id="eSubmit" class="primary">Enregistrer</button>',
      '</div>',
    ].join(''));
    bg.querySelector('#eCancel').onclick = function () { closeModal(bg); };
    bg.querySelector('#eSubmit').onclick = function () {
      var err = bg.querySelector('#eErr');
      err.style.display = 'none';
      var submit = bg.querySelector('#eSubmit');
      var file = bg.querySelector('#eFile').files[0];
      var patch = {
        name: bg.querySelector('#eName').value.trim(),
        version: bg.querySelector('#eVersion').value.trim(),
        vendor: bg.querySelector('#eVendor').value.trim(),
        silentArgs: bg.querySelector('#eSilent').value.trim(),
        archiveInstaller: bg.querySelector('#eArchive').value.trim(),
        arch: bg.querySelector('#eArch').value,
      };
      // Le champ installer n'est patché que s'il n'y a pas de remplacement ET
      // qu'il a été modifié manuellement par l'utilisateur. Sinon c'est
      // replaceInstaller qui le réécrit lui-même.
      var newInstaller = bg.querySelector('#eInstaller').value.trim();
      if (!file && newInstaller !== s.installer) patch.installer = newInstaller;

      // Étape 1 (optionnelle): upload du binaire de remplacement.
      submit.disabled = true; submit.textContent = file ? 'Préparation…' : 'Enregistrement…';
      var step1 = file
        ? api('requestUploadToken', { mode: 'replace', slug: slug, filename: file.name }).then(function (rt) {
            if (rt.error) return rt;
            submit.textContent = 'Upload…';
            return fetch(rt.url, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/octet-stream' }, body: file })
              .then(function (r) { return r.json(); });
          })
        : Promise.resolve({ ok: true });

      step1.then(function (r1) {
        if (r1.error) { err.textContent = r1.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Enregistrer'; return null; }
        // Étape 2: mise à jour des métadonnées (toujours faite, même sans patch
        // — c'est une no-op côté serveur si rien n'a changé).
        submit.textContent = 'Enregistrement…';
        return api('updateSoftware', { slug: slug }, patch);
      }).then(function (r2) {
        if (!r2) return;
        if (r2.error) { err.textContent = r2.error; err.style.display = 'block'; submit.disabled = false; submit.textContent = 'Enregistrer'; return; }
        closeModal(bg); load();
      });
    };
  }

  function deleteSoftware(slug) {
    var s = softwares.find(function (x) { return x.id === slug; });
    if (!s) return;
    if (!confirm('Supprimer définitivement ' + s.name + ' ?\n\nLe dossier ' + slug + ' et tous ses fichiers seront effacés sur le NAS.')) return;
    api('deleteSoftware', { slug: slug }).then(function (r) {
      if (r.error) { alert('Erreur: ' + r.error); return; }
      delete softSel[slug];
      load();
    });
  }

  $('addSoftBtn').onclick = openAdd;
  api('ping').then(function () {});
  load();
</script>
</body>
</html>
